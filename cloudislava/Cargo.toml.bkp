# Cargo.toml
[package]
name = "cloud-is-lava"
version = "0.1.0"
edition = "2021"

[dependencies]
dropbox-sdk = "0.14"
tokio = { version = "1.0", features = ["full"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
chrono = { version = "0.4", features = ["serde"] }
ring = "0.17"
aes-gcm = { version = "0.10", features = ["std"] }
hmac = "0.12"
sha2 = "0.10"
uuid = { version = "1.0", features = ["v4", "serde"] }
rusqlite = "0.29"
thiserror = "1.0"
log = "0.4"
env_logger = "0.10"
async-trait = "0.1"
anyhow = "1.0"
base64 = "0.21"
rpassword = "7.2"
zeroize = "1.6"
clap = { version = "4.0", features = ["derive"] }
reqwest = { version = "0.11", features = ["json"] }
bytes = "1.0"
