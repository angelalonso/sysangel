              "Height": 150.0,
              "Left": 0.0,
              "Top": 150.0,
              "Visible": true,
              "Width": 320.0,
              "Name": "AirTempValue",
              "RenderingSkip": 0,
              "Bindings": {
                "Text": {
                  "Formula": {
                    "Expression": "if(!$prop('AirTemperature'), '-', Math.round($prop('AirTemperature')) + '\u00b0')"
                  },
                  "Mode": 2,
                  "TargetPropertyName": "Text"
                }
              },
              "$id": "15",
              "IsFreezed": false,
              "IsSelected": false,
              "Sid": 8,
              "Id": "319b4970-d1b1-4f79-b7e5-e3ed097e2a50",
              "BlinkDelay": 250.0,
              "BlinkEnabled": false,
              "Rotation": 0.0,
              "UseRotation": false,
              "CanResize": true,
              "BlurRadius": 0.0,
              "EnableBlur": false,
              "BorderColor": "#00000000",
              "BorderTop": 0,
              "BorderBottom": 0,
              "BorderLeft": 0,
              "BorderRight": 0,
              "Opacity": 100.0
            },
            {
              "$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins",
              "IsTextItem": true,
              "Font": "DS-Digital",
              "FontSize": 74.0,
              "ShadowDepth": 0,
              "ShadowBlur": 2,
              "ShadowDirection": 0,
              "ShadowColor": "#FF173A68",
              "Text": "00\u00b0",
              "TextColor": "#FFB7F1FF",
              "HorizontalAlignment": 1,
              "VerticalAlignment": 1,
              "BackgroundColor": "#00000000",
              "Height": 150.0,
              "Left": 320.0,
              "Top": 150.0,
              "Visible": true,
              "Width": 320.0,
              "Name": "TrackTempValue",
              "RenderingSkip": 0,
              "Bindings": {
                "Text": {
                  "Formula": {
                    "Expression": "let roadTemp = $prop('RoadTemperature')\nlet ambTemp = $prop('AirTemperature')\nif (!roadTemp) return '-'\nif (roadTemp != ambTemp) return Math.round(roadTemp) + '\u00b0'\nlet gtr2TrackTemp = $prop('GameRawData.Data.trackTemp')\nlet tempUnit = String($prop('TemperatureUnit')).toUpperCase()\nif (gtr2TrackTemp !== null) {\n if (tempUnit == 'FAHRENHEIT') gtr2TrackTemp = gtr2TrackTemp * (9/5) + 32\n return Math.round(gtr2TrackTemp) + '\u00b0'\n}\nreturn Math.round(roadTemp) + '\u00b0'"
                  },
                  "Mode": 2,
                  "TargetPropertyName": "Text"
                }
              },
              "$id": "15",
              "IsFreezed": false,
              "IsSelected": false,
              "Sid": 8,
              "Id": "04831c5f-03e2-4749-939a-c9ffd90e0a1f",
              "BlinkDelay": 250.0,
              "BlinkEnabled": false,
              "Rotation": 0.0,
              "UseRotation": false,
              "CanResize": true,
              "BlurRadius": 0.0,
              "EnableBlur": false,
              "BorderColor": "#00000000",
              "BorderTop": 0,
              "BorderBottom": 0,
              "BorderLeft": 0,
              "BorderRight": 0,
              "Opacity": 100.0
            },
            {
              "$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins",
              "IsTextItem": true,
              "Font": "DS-Digital",
              "FontSize": 52.0,
              "ShadowDepth": 0,
              "ShadowBlur": 2,
              "ShadowDirection": 0,
              "ShadowColor": "#FF173A68",
              "Text": "SUNNY",
              "TextColor": "#FFB7F1FF",
              "HorizontalAlignment": 1,
              "VerticalAlignment": 1,
              "BackgroundColor": "#00000000",
              "Height": 150.0,
              "Left": 640.0,
              "Top": 150.0,
              "Visible": true,
              "Width": 320.0,
              "Name": "WeatherValue",
              "RenderingSkip": 0,
              "Bindings": {
                "Text": {
                  "Formula": {
                    "Expression": "let rain = $prop('GameRawData.Data.raining')\nlet wet = $prop('GameRawData.Data.onPathWetness')\nlet clouds = $prop('GameRawData.Data.darkCloud')\nif (rain >= 0.10) return 'RAINING'\nif (wet >= 0.15) return 'WET'\nif (clouds >= 0.66) return 'OVERCAST'\nif (clouds >= 0.33) return 'CLOUDY'\nreturn 'SUNNY'"
                  },
                  "Mode": 2,
                  "TargetPropertyName": "Text"
                }
              },
              "$id": "15",
              "IsFreezed": false,
              "IsSelected": false,
