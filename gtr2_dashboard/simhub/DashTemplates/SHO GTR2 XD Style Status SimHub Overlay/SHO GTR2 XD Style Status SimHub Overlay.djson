              "Sid": 0,
              "Bindings": {
                "$id": "77",
                "Text": {
                  "$id": "78",
                  "FormatString": "0.0",
                  "Formula": {
                    "$id": "79",
                    "Interpreter": 1,
                    "Expression": "econLPL = $prop('DataCorePlugin.Computed.Fuel_LitersPerLap')\r\necon = econLPL\r\nunit = String($prop('FuelUnit')).toUpperCase()\r\nif ( unit == 'GALLONS' ) econ *= 0.2641720524 // Imperial Gallon = 0.2199692 Litres; US Gallon = 0.2641720524 Litres\r\necon = Math.round(econ * 10) / 10\r\nif ( econ < 0.1 ) econ = 0.1\r\nreturn econ"
                  },
                  "Mode": 2,
                  "TargetPropertyName": "Text"
                }
              }
            },
