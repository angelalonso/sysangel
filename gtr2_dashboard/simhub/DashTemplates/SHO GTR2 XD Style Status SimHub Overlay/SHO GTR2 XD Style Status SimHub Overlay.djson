              "Height": 60.0,
              "Left": 435.0,
              "Opacity": 100.0,
              "Top": -10.0,
              "Visible": true,
              "BlinkDelay": 250.0,
              "BlinkEnabled": false,
              "Width": 66.0,
              "BorderBottom": 0,
              "BorderColor": "#FFFFFFFF",
              "BorderLeft": 0,
              "BorderRight": 0,
              "BorderTop": 0,
              "Id": "14277ef1-57f7-4308-a660-8de88cd18b8b",
              "IsFreezed": false,
              "IsSelected": false,
              "Name": "LapsValue",
              "RenderingSkip": 60,
              "Sid": 0,
              "Bindings": {
                "$id": "61",
                "Text": {
                  "$id": "62",
                  "FormatString": "0",
                  "Formula": {
                    "$id": "63",
                    "Interpreter": 1,
                    "Expression": "//return $prop('DataCorePlugin.Computed.Fuel_RemainingLaps') // [SimHub Bug] SimHub changes RemainingLaps based on Fuel Unit setting but it shouldn't since it has no bearing on remaining laps.\r\neconLPL = $prop('DataCorePlugin.Computed.Fuel_LitersPerLap')\r\nif ( ! econLPL || econLPL < 0.1 ) econLPL = 0.4 // ~0.1 US Gallons; 1 Litre = 3.7854117834 US Gallons\r\nfuel = $prop('Fuel')\r\nunit = String($prop('FuelUnit')).toUpperCase()\r\nif ( unit == 'GALLONS' ) econLPL *= 0.2641720524 // Imperial Gallon = 0.2199692 Litres; US Gallon = 0.2641720524 Litres\r\n//if ( econLPL < 0.1 ) econLPL = 0.1\r\nlaps = fuel / econLPL\r\nreturn Math.floor(laps)"
                  },
                  "Mode": 2,
                  "TargetPropertyName": "Text"
                },
                "TextColor": {
                  "$id": "64",
                  "Formula": {
                    "$id": "65",
                    "Interpreter": 1,
                    "Expression": "//return $prop('DataCorePlugin.Computed.Fuel_RemainingLaps') // [SimHub Bug] SimHub changes RemainingLaps based on Fuel Unit setting but it shouldn't since it has no bearing on remaining laps.\r\neconLPL = $prop('DataCorePlugin.Computed.Fuel_LitersPerLap')\r\nif ( ! econLPL ) return 5 // Middle Color\r\nfuel = $prop('Fuel')\r\nunit = String($prop('FuelUnit')).toUpperCase()\r\nif ( unit == 'GALLONS' ) econLPL *= 0.2641720524 // Imperial Gallon = 0.2199692 Litres; US Gallon = 0.2641720524 Litres\r\n//if ( econLPL < 0.1 ) econLPL = 0.1\r\nlaps = fuel / econLPL\r\nif ( ! laps ) return 5 // Middle Color\r\nreturn Math.floor(laps)\r\n\r\n\r\n"
                  },
                  "StartColor": "#FFFF0000",
                  "EnableMiddleColor": true,
                  "MiddleColor": "#FFFFA500",
                  "MiddleColorValue": 5.0,
                  "EndColor": "#FF7FFF00",
                  "StartColorValue": 2.0,
                  "EndColorValue": 15.0,
                  "Mode": 4,
                  "TargetPropertyName": "TextColor"
                }
              }
