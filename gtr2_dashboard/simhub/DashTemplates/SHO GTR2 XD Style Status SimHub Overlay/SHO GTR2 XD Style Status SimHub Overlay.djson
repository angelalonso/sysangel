                  "$id": "108"
                }
              },
              "Height": 60.0,
              "Left": 395.0,
              "Opacity": 100.0,
              "Top": 70.0,
              "Visible": true,
              "BlinkDelay": 250.0,
              "BlinkEnabled": false,
              "Width": 180.0,
              "BorderBottom": 0,
              "BorderColor": "#FFFFFFFF",
              "BorderLeft": 0,
              "BorderRight": 0,
              "BorderTop": 0,
              "Id": "7917cd3e-e6f1-4fff-9a22-f1f115c8e145",
              "IsFreezed": false,
              "IsSelected": false,
              "Name": "OptimalLapTimeValue",
              "RenderingSkip": 60,
              "Sid": 0,
              "Bindings": {
                "$id": "109",
                "Text": {
                  "$id": "110",
                  "FormatString": "mm\\:ss\\.fff",
                  "Formula": {
                    "$id": "111",
                    "Interpreter": 1,
                    "Expression": "// Session reset logic: Session restarted, SimHub replay rewind, etc.\r\nif ( root['SessionTimeLeft'] && timespantoseconds($prop('SessionTimeLeft')) > timespantoseconds(root['SessionTimeLeft']) ) {\r\n\tfor ( var key in root ) delete root[key]\r\n}\r\nroot['SessionTimeLeft'] = $prop('SessionTimeLeft')\r\n\r\n// State tracking\r\nif ( ! root['sectorCount'] || $prop('CurrentSectorIndex') > root['sectorCount'] ) root['sectorCount'] = $prop('CurrentSectorIndex')\r\nif ( root['sectorCount'] > 1 && $prop('CurrentSectorIndex') == 1 ) root['finalSectorIndex'] = root['sectorCount']\r\n\r\n// Return default if we don't have final sector count yet\r\nif ( ! root['finalSectorIndex'] ) return '--:--.---'\r\n\r\n// Sum up sector times\r\nlet optimalTimeSec = 0\r\nfor ( let sectorIndex = 1; sectorIndex <= root['finalSectorIndex']; sectorIndex++ ) {\r\n\tlet sectorBestTimeKey = 'Sector' + sectorIndex + 'BestTime'\r\n\tlet sectorBestTime = $prop(sectorBestTimeKey)\r\n\tif ( ! sectorBestTime ) return '--:--.---'\r\n\tlet sectorBestTimeSec = timespantoseconds(sectorBestTime)\r\n\toptimalTimeSec += sectorBestTimeSec\r\n}\r\n\r\nif ( optimalTimeSec ) return secondstotimespan(optimalTimeSec)\r\n\r\nreturn '--:--.---'\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n//s1 = $prop('Sector1BestLapTime')\r\ns1 = $prop('Sector1BestTime')\r\n//s2 = $prop('Sector2BestLapTime')\r\ns2 = $prop('Sector2BestTime')\r\n//s3 = $prop('Sector3BestLapTime')\r\ns3 = $prop('Sector3BestTime')\r\n\r\nif ( ! (s1 && s2 && s3) ) return '--:--.---'\r\n\r\n//return s1\r\ns1Parts = String(s1).split(':')\r\ns1Hour = parseInt(s1Parts[0])\r\ns1Min = parseInt(s1Parts[1])\r\ns1Sec = parseFloat(s1Parts[2])\t\r\n//return s1Hour + '-' + s1Min + '-' + s1Sec\r\ns1TotalSec = (s1Hour * 60 * 60) + (s1Min * 60) + s1Sec\r\n//return s1TotalSec\r\n\r\n\r\n//return s2\r\ns2Parts = String(s2).split(':')\r\ns2Hour = parseInt(s2Parts[0])\r\ns2Min = parseInt(s2Parts[1])\r\ns2Sec = parseFloat(s2Parts[2])\t\r\n//return s2Hour + '-' + s2Min + '-' + s2Sec\r\ns2TotalSec = (s2Hour * 60 * 60) + (s2Min * 60) + s2Sec\r\n//return s1TotalSec\r\n\r\n\r\n//return s3\r\ns3Parts = String(s3).split(':')\r\ns3Hour = parseInt(s3Parts[0])\r\ns3Min = parseInt(s3Parts[1])\r\ns3Sec = parseFloat(s3Parts[2])\t\r\n//return s3Hour + '-' + s3Min + '-' + s3Sec\r\ns3TotalSec = (s3Hour * 60 * 60) + (s3Min * 60) + s3Sec\r\n//return s3TotalSec\r\n\r\ntotalTimeSec = s1TotalSec + s2TotalSec + s3TotalSec\r\n//return totalSec\r\ntotalHour = ( totalTimeSec >= 3600 ) ? parseInt(totalTimeSec / 3600) : 0\r\n//return totalHour\r\ntotalHourSec = totalHour * 60 * 60\r\n//return totalHourSec\r\n\r\ntotalMin = totalTimeSec - totalHourSec\r\ntotalMin = ( totalTimeSec >= 60 ) ? parseInt(totalTimeSec / 60) : 0\r\n//return totalMin\r\ntotalMinSec = totalMin * 60\r\n\r\ntotalSec = totalTimeSec - totalHourSec - totalMinSec\r\n//totalSec = ( totalSec >= 60 ) ? parseInt(totalSec / 60) : 0\r\n//return totalSec\r\n\r\n\r\nif ( ! totalTimeSec ) return '--:--.---'\r\nif ( totalHour ) return format(totalHour, '00') + ':' + format(totalMin, '00') + ':' + format(totalSec, '00.000')\r\nreturn format(totalMin, '00') + ':' + format(totalSec, '00.000')\r\n\r\n"
                  },
                  "Mode": 2,
                  "TargetPropertyName": "Text"
                }
              }
            }
          ]
        },
        "Id": "bc25cec2-f435-47aa-ad01-fb40525284de",
        "Name": "Screen1",
        "Sid": 0,
        "Bindings": {
          "$id": "112"
        }
      }
    ]
