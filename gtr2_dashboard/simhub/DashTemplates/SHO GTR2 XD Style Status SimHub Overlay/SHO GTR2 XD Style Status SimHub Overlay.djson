              "IsFreezed": false,
              "IsSelected": false,
              "Name": "TrackTempValue",
              "RenderingSkip": 60,
              "Sid": 0,
              "Bindings": {
                "$id": "25",
                "Text": {
                  "$id": "26",
                  "FormatString": "0",
                  "Formula": {
                    "$id": "27",
                    "Interpreter": 1,
                    "Expression": "// Check support\r\nlet tempSupported = ( $prop('RoadTemperature') )\r\nif ( ! tempSupported ) return '-'\r\n\r\nroadTemp = $prop('RoadTemperature')\r\nambTemp = $prop('AirTemperature')\r\nif ( roadTemp != ambTemp ) return Math.round(roadTemp) + '°';\r\ngtr2TrackTemp = $prop('GameRawData.Data.trackTemp')\r\ntempUnit = String($prop('TemperatureUnit')).toUpperCase()\r\nif ( gtr2TrackTemp !== null ) {\r\n if ( tempUnit == 'FAHRENHEIT' ) gtr2TrackTemp = gtr2TrackTemp * (9/5) + 32\r\n return Math.round(gtr2TrackTemp) + '°';\r\n}\r\nreturn Math.round(roadTemp) + '°';\r\n//return Math.round($prop('TyreTemperatureFrontLeft')) + '°'\r\n"
                  },
                  "Mode": 2,
                  "TargetPropertyName": "Text"
                },
                "TextColor": {
                  "$id": "28",
                  "Formula": {
                    "$id": "29",
                    "Interpreter": 1,
                    "Expression": "// Check support\r\nlet tempSupported = ( $prop('RoadTemperature') )\r\nif ( ! tempSupported ) return 'Gray'\r\n\r\nreturn 'Orange'"
                  },
                  "Mode": 2,
                  "TargetPropertyName": "TextColor"
                }
              }
            },
