iveDelayConstrainer":false,"IsFreezed":true,"Name":"iRating Gain/Loss","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"FormatString":"","Formula":{"Interpreter":1,"Expression":"var myclass = $prop('DataCorePlugin.GameData.NewData.CarClass');\r\nvar opo = $prop('DataCorePlugin.GameData.NewData.OpponentsCount');\r\nvar opoclass = $prop('DataCorePlugin.GameData.NewData.PlayerClassOpponentsCount')\r\nvar myir = driveriracingirating($prop('DataCorePlugin.GameData.NewData.Position'));\r\nvar classpos = $prop('DataCorePlugin.GameRawData.Telemetry.PlayerCarClassPosition');\r\nvar weight = 1600/Math.log(2);\r\nvar fudge = (opoclass/2-classpos)/100;\r\n\r\nvar iratings= [];\r\n\tfor(var r=1; r<opo+1; r++){\r\n\tif (drivercarclass(r)==myclass) {\r\n\t\tiratings[r] = driveriracingirating(r);\r\n\t} \r\n\telse {\r\n\t\tiratings[r] = 0};\r\n\t}\r\n\r\nvar filtered= [],tmp;\r\n\tfor(var a=1; a<iratings.length ; a++){\r\n\t\ttmp = iratings[a];\r\n\t\tif( tmp !== 0){\r\n\t\t\tfiltered.push( tmp );\r\n\t\t}\r\n\t}\r\n\t\r\nvar tmpexpscore = 0;\r\n\tfor(var i=0; i<opoclass; i++) {\r\n\ttmpexpscore +=\r\n\t\t(1-Math.exp(-myir/weight))*\r\n\t\tMath.exp(-filtered[i]/weight)/\r\n\t\t((1-Math.exp(-filtered[i]/weight))*\r\n\t\tMath.exp(-myir/weight)+\r\n\t\t(1-Math.exp(-myir/weight))*\r\n\t\tMath.exp(-filtered[i]/weight));\r\n\t}\r\n\r\nvar expscore = tmpexpscore-0.5;\r\nvar irchange = Math.round((opoclass -classpos -expscore -fudge)*200/opoclass);\r\n\r\nreturn (irchange<=0?\"\":\"+\") + irchange + ' ';"},"Mode":2,"TargetPropertyName":"Text"},"Top":{"Formula":{"Expression":"2.5\r\n-\r\nisnull([variable.HUD_TopScreen2Animation],0)"},"Mode":2,"TargetPropertyName":"Top"},"Visible":{"Formula":{"Expression":"isnull([DataCorePlugin.CurrentGame],0)='IRacing'\r\nand\r\nisnull([DataCorePlugin.GameRunning],0)=1\r\nand\r\nisnull([DataCorePlugin.GameData.NewData.SessionTypeName],0)='Race'\r\nand\r\nin(isnull([DataCorePlugin.GameRawData.Telemetry.SessionState],0),4,5,6)\r\nand\r\nisnull([DataCorePlugin.GameRawData.Telemetry.EnterExitReset],0)!=0"},"Mode":2,"TargetPropertyName":"Visible"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"ShadowBlur":10,"ShadowColor":"#FFA9A9A9","Font":"LCDMono","FontSize":15.0,"Text":"2.3k ","TextColor":"#FFE6E6FA","HorizontalAlignment":2,"VerticalAlignment":1,"TextMask":"0000000000","BackgroundColor":"#00FFFFFF","BorderStyle":{"BorderColor":"#FF808080"},"Height":20.0,"Left":193.0,"Top":17.5,"Visible":true,"Width":100.0,"IsEffectiveDelayConstrainer":false,"IsFreezed":true,"Name":"Class SOF","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"FormatString":"","Formula":{"Interpreter":1,"Expression":"var myclass = $prop('DataCorePlugin.GameData.NewData.CarClass');\r\nvar opo = $prop('DataCorePlugin.GameData.NewData.OpponentsCount');\r\nvar opoclass = $prop('DataCorePlugin.GameData.NewData.PlayerClassOpponentsCount');\r\n\r\nvar iratings= [];\r\n\tfor(var r=0; r<opo+1; r++){\r\n\tif(drivercarclass(r)==myclass){\r\n\t\tiratings[r] = driveriracingirating(r);\r\n\t} \r\n\telse {\r\n\t\tiratings[r] = 0};\r\n\t}\r\n\r\nvar filtered= [],tmp;\r\n\tfor(var a=0, l=iratings.length; a<l; a++){\r\n\t\ttmp = iratings[a];\r\n\t\tif( tmp !== 0){\r\n\t\t\tfiltered.push( tmp );\r\n\t\t}\r\n\t}\r\n\r\nvar sum = 0;\r\n\r\nfor (var i = 0; i < opoclass; i++){\r\n\tsum += Math.pow(2, -filtered[i] / 1600);\r\n\t}\r\n\r\nvar sof = Math.round(1600 / Math.log(2) * Math.log(opoclass / sum));\r\nvar sofk = Math.round(sof/100)/10 +'k'\r\nreturn sofk+' ';"},"Mode":2,"TargetPropertyName":"Text"},"Visible":{"Formula":{"Expression":"isnull([DataCorePlugin.CurrentGame],0)='IRacing'\r\nand\r\nisnull([DataCorePlugin.GameRunning],0)=1"},"Mode":2,"TargetPropertyName":"Visible"},"Top":{"Formula":{"Expression":"19.5\r\n-\r\nisnull([variable.HUD_TopScreen2Animation],0)"},"Mode":2,"TargetPropertyName":"Top"}}}],"Group":true,"Visible":true,"IsEffectiveDelayConstrainer":false,"Name