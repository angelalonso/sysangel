tance') || $prop('PersistantTrackerPlugin.DriverAhead_00_Gap') )\r\nif ( ! gapSupported ) return 'Gray'\r\n\r\nreturn 'Orange'"},"Mode":2,"TargetPropertyName":"TextColor"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.BuiltIn.SpeedText, SimHub.Plugins","Format":"0","NoDataText":"0","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":35.0,"TextColor":"#FFFFA500","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":140.0,"Top":20.0,"Visible":true,"BlinkDelay":200.0,"Width":80.0,"Name":"SpeedValue","Bindings":{"TextColor":{"Formula":{"Interpreter":1,"Expression":"//if ( $prop('Rpms') >= $prop('CarSettings_RedLineRPM') ) return 'Red';\r\nif ( ! $prop('EngineIgnitionOn') ) return 'DimGray'\r\nif ( $prop('Rpms') * 1.0234375 >= $prop('CarSettings_MaxRPM') ) return 'Red';\r\nreturn 'Orange';"},"Mode":2,"TargetPropertyName":"TextColor"},"BlinkEnabled":{"Formula":{"Interpreter":1,"Expression":"if ( ! $prop('EngineIgnitionOn') ) return false\r\n//if ( $prop('Rpms') >= $prop('CarSettings_RedLineRPM') ) return 'Red';\r\nif ( $prop('Rpms') * 1.0234375 >= $prop('CarSettings_MaxRPM') ) return true;\r\nreturn false;\r\n\r\n"},"Mode":2,"TargetPropertyName":"BlinkEnabled"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.BuiltIn.GearText, SimHub.Plugins","GearBlinkText":false,"GearBlinkDelay":200,"TextColor":"#FFFFA500","BackgroundColor":"#00FFFFFF","GearBackgoundColor":"#00FFFFFF","IgnoreNeutralGear":false,"GearBlinkBackgroundColor":"#FFFF0000","GearBlinkBackground":false,"GearTextColor":"#FFFFA500","GearBlinkTextColor":"#00FFFFFF","DesignerText":"6","NoDataText":"N","IsTextItem":true,"Font":"Segoe UI Historic","FontWeight":"Bold","FontSize":120.0,"HorizontalAlignment":1,"VerticalAlignment":1,"Height":106.0,"Left":127.0,"Top":67.0,"Visible":true,"Width":106.0,"Name":"GearValue","Bindings":{"GearBlinkTextColor":{"Formula":{"Interpreter":1,"Expression":"if ( $prop('Rpms') * 1.0234375 >= $prop('CarSettings_MaxRPM') ) return 'Transparent';\r\nreturn 'Orange';"},"Mode":2,"TargetPropertyName":"GearBlinkTextColor"},"GearTextColor":{"Formula":{"Interpreter":1,"Expression":"if ( ! $prop('EngineIgnitionOn') ) return 'DimGray'\r\nif ( $prop('Rpms') * 1.0234375 >= $prop('CarSettings_MaxRPM') ) return 'Red';\r\nreturn 'Orange'"},"Mode":2,"TargetPropertyName":"GearTextColor"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.BuiltIn.RPMText, SimHub.Plugins","Format":"0","NoDataText":"0","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":25.0,"TextColor":"#FFFFA500","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":130.0,"Top":180.0,"Visible":true,"BlinkDelay":200.0,"Width":100.0,"Name":"RPMValue","Bindings":{"TextColor":{"Formula":{"Interpreter":1,"Expression":"if ( ! $prop('EngineIgnitionOn') ) return 'DimGray'\r\n//if ( $prop('Rpms') >= $prop('CarSettings_RedLineRPM') ) return 'Red';\r\nif ( $prop('Rpms') * 1.0234375 >= $prop('CarSettings_MaxRPM') ) return 'Red';\r\nreturn 'Orange';"},"Mode":2,"TargetPropertyName":"TextColor"},"BlinkEnabled":{"Formula":{"Interpreter":1,"Expression":"if ( ! $prop('EngineIgnitionOn') ) return 'DimGray'\r\n//if ( $prop('Rpms') >= $prop('CarSettings_RedLineRPM') ) return 'Red';\r\nif ( $prop('Rpms') * 1.0234375 >= $prop('CarSettings_MaxRPM') ) return true;\r\nreturn false;"},"Mode":2,"TargetPropertyName":"BlinkEnabled"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":10.0,"Text":"TIME","TextColor":"#FFFFFFFF","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":240.0,"Top":10.0,"Visible":true,"Width":60.0,"Name":"TimeText"},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":22.0,"Text":"0:00.00","TextColor":"#FFFFA500","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":220.0,"Top":30.0,"Visible":true,"Width":100.0,"Name":"TimeRemainingValue","RenderingSkip":60,"Bindings":{"Text":{"FormatString":"h\\:mm\\:ss","Formula":{"Interpreter":1,"Expression":"return $prop('SessionTimeLeft')"},"Mode":2,"TargetPropertyName":"Text"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":10.0,"Text":"LAST","TextColor":"#FFFFFFFF","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":220.0,"Top":180.0,"Visible":true,"Width":100.0,"Name":"LastText"},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.BuiltIn.LastLapTime, SimHub.Plugins","TimeFormat":"mm\\:ss\\.fff","EmptyTimeText":"--:--.---","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":22.0,"TextColor":"#FFFFA500","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":220.0,"Top":200.0,"Visible":true,"Width":100.0,"Name":"LastLapTime","RenderingSkip":60},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":10.0,"Text":"BEHIND","TextColor":"#FFFFFFFF","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":230.0,"Top":60.0,"Visible":true,"Width":80.0,"Name":"PrevText"},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":22.0,"Text":"0.0","TextColor":"#FFFFA500","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":220.0,"Top":80.0,"Visible":true,"Width":100.0,"Name":"PrevCarGapValue","RenderingSkip":15,"Bindings":{"Text":{"FormatString":"0.00","Formula":{"Interpreter":1,"Expression":"// Check support\r\nlet gapSupported = ( $prop('PersistantTrackerPlugin.DriverBehind_00_CurrentLap') || $prop('PersistantTrackerPlugin.DriverBehind_00_Distance') || $prop('PersistantTrackerPlugin.DriverBehind_00_Gap') )\r\nif ( ! gapSupported ) return '-'\r\n\r\ngap = $prop('PersistantTrackerPlugin.DriverBehind_00_Gap');\r\ngap = gap.toFixed(1);\r\nif ( gap > 0 ) return '+' + gap;\r\nreturn '-';"},"Mode":2,"TargetPropertyName":"Text"},"TextColor":{"Formula":{"Interpreter":1,"Expression":"// Check support\r\nlet gapSupported = ( $prop('PersistantTrackerPlugin.DriverBehind_00_CurrentLap') || $prop('PersistantTrackerPlugin.DriverBehind_00_Distance') || $prop('PersistantTrackerPlugin.DriverBehind_00_Gap') )\r\nif ( ! gapSupported ) return 'Gray'\r\n\r\nreturn 'Orange'"},"Mode":2,"TargetPropertyName":"TextColor"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":10.0,"Text":"OPTIMAL","TextColor":"#FFFFFFFF","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":220.0,"Top":120.0,"Visible":true,"Width":100.0,"Name":"OptimalText"},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":22.0,"Text":"--:--.---","TextColor":"#FFFFA500","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":220.0,"Top":140.0,"Visible":true,"Width":100.0,"Name":"OptimalLapTimeValue","RenderingSkip":60,"Bindings":{"Text":{"FormatString":"mm\\:ss\\.fff","Formula":{"Interpreter":1,"Expression":"// Session reset logic: Session restarted, SimHub replay rewind, etc.\r\nif ( root['SessionTimeLeft'] && timespantoseconds($prop('SessionTimeLeft')) > timespantoseconds(root['SessionTimeLeft']) ) {\r\n\tfor ( var key in root ) delete root[key]\r\n}\r\nroot['SessionTimeLeft'] = $prop('SessionTimeLeft')\r\n\r\n// State tracking\r\nif ( ! root['sectorCount'] || $prop('CurrentSectorIndex') > root['sectorCount'] ) root['sectorCount'] = $prop('CurrentSectorIndex')\r\nif ( root['sectorCount'] > 1 && $prop('CurrentSectorIndex') == 1 ) root['finalSectorIndex'] = root['sectorCount']\r\n\r\n// Return default if we don't have final sector count yet\r\nif ( ! root['finalSectorIndex'] ) return '--:--.---'\r\n\r\n// Sum up sector times\r\nlet optimalTimeSec = 0\r\nfor ( let sectorIndex = 1; sectorIndex <= root['finalSectorIndex']; sectorIndex++ ) {\r\n\tlet sectorBestTimeKey = 'Sector' + sectorIndex + 'BestTime'\r\n\tlet sectorBestTime = $prop(sectorBestTimeKey)\r\n\tif ( ! sectorBestTime ) return '--:--.---'\r\n\tlet sectorBestTimeSec = timespantoseconds(sectorBestTime)\r\n\toptimalTimeSec += sectorBestTimeSec\r\n}\r\n\r\nif ( optimalTimeSec ) return secondstotimespan(optimalTimeSec)\r\n\r\nreturn '--:--.---'\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n//s1 = $prop('Sector1BestLapTime')\r\ns1 = $prop('Sector1BestTime')\r\n//s2 = $prop('Sector2BestLapTime')\r\ns2 = $prop('Sector2BestTime')\r\n//s3 = $prop('Sector3BestLapTime')\r\ns3 = $prop('Sector3BestTime')\r\n\r\nif ( ! (s1 && s2 && s3) ) return '--:--.---'\r\n\r\n//return s1\r\ns1Parts = String(s1).split(':')\r\ns1Hour = parseInt(s1Parts[0])\r\ns1Min = parseInt(s1Parts[1])\r\ns1Sec = parseFloat(s1Parts[2])\t\r\n//return s1Hour + '-' + s1Min + '-' + s1Sec\r\ns1TotalSec = (s1Hour * 60 * 60) + (s1Min * 60) + s1Sec\r\n//return s1TotalSec\r\n\r\n\r\n//return s2\r\ns2Parts = String(s2).split(':')\r\ns2Hour = parseInt(s2Parts[0])\r\ns2Min = parseInt(s2Parts[1])\r\ns2Sec = parseFloat(s2Parts[2])\t\r\n//return s2Hour + '-' + s2Min + '-' + s2Sec\r\ns2TotalSec = (s2Hour * 60 * 60) + (s2Min * 60) + s2Sec\r\n//return s1TotalSec\r\n\r\n\r\n//return s3\r\ns3Parts = String(s3).split(':')\r\ns3Hour = parseInt(s3Parts[0])\r\ns3Min = parseInt(s3Parts[1])\r\ns3Sec = parseFloat(s3Parts[2])\t\r\n//return s3Hour + '-' + s3Min + '-' + s3Sec\r\ns3TotalSec = (s3Hour * 60 * 60) + (s3Min * 60) + s3Sec\r\n//return s3TotalSec\r\n\r\ntotalTimeSec = s1TotalSec + s2TotalSec + s3TotalSec\r\n//return totalSec\r\ntotalHour = ( totalTimeSec >= 3600 ) ? parseInt(totalTimeSec / 3600) : 0\r\n//return totalHour\r\ntotalHourSec = totalHour * 60 * 60\r\n//return totalHourSec\r\n\r\ntotalMin = totalTimeSec - totalHourSec\r\ntotalMin = ( totalTimeSec >= 60 ) ? parseInt(totalTimeSec / 60) : 0\r\n//return totalMin\r\ntotalMinSec = totalMin * 60\r\n\r\ntotalSec = totalTimeSec - totalHourSec - totalMinSec\r\n//totalSec = ( totalSec >= 60 ) ? parseInt(totalSec / 60) : 0\r\n//return totalSec\r\n\r\n\r\nif ( ! totalTimeSec ) return '--:--.---'\r\nif ( totalHour ) return format(totalHour, '00') + ':' + format(totalMin, '00') + ':' + format(totalSec, '00.000')\r\nreturn format(totalMin, '00') + ':' + format(totalSec, '00.000')\r\n\r\n"},"Mode":2,"TargetPropertyName":"Text"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins","IsRectangleItem":true,"Rotation":270.0,"BackgroundColor":"#00FFFFFF","Height":20.0,"Left":230.0,"Top":110.0,"Visible":true,"Width":220.0,"Name":"RpmRightActuatedRect","Bindings":{"BackgroundColor":{"Formula":{"Interpreter":1,"Expression":"if ( $prop('EngineIgnitionOn') ) return 'DimGray'\r\n//if ( $prop('EngineStarted') && $prop('Rpms') > 0 ) return 'DimGray'\r\nreturn 'Transparent'"},"Mode":2,"TargetPropertyName":"BackgroundColor"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.LinearGaugeItem, SimHub.Plugins","IsLinearGauge":true,"GaugeOrientation":0,"GaugeAlignment":0,"AutoSize":false,"GaugeColor":"#FF32CD32","AlternateGaugeColor":"#FF008000","UseAlternateStyle":false,"Minimum":0.0,"Maximum":100.0,"Value":20.0,"Steps":0.0,"PAW":44.0,"Rotation":270.0,"BackgroundColor":"#00FFFFFF","BorderStyle":{"BorderColor":"#00FFFFFF","BorderTop":2,"BorderBottom":2,"BorderLeft":2,"BorderRight":2,"Bindings":{"BorderColor":{"Formula":{"Interpreter":1,"Expression":"//if ( $prop('Rpms') >= $prop('CarSettings_RedLineRPM') ) return 'Red';\r\n//return 'Orange';\r\nif ( $prop('EngineStarted') && $prop('Rpms') > 0 ) return 'Orange'\r\nreturn 'DimGray'"},"Mode":2,"TargetPropertyName":"BorderColor"}}},"Height":20.0,"Left":230.0,"Top":110.0,"Visible":true,"BlinkDelay":750.0,"Width":220.0,"Name":"RpmRightLinearGauge","Bindings":{"Value":{"Formula":{"Interpreter":1,"Expression":"//return $prop('MaxSpeedKmh')\r\n//$prop('CarSettings_MaxRPM')\r\n//$prop('CarSettings_RedLineRPM')\r\nreturn $prop('Rpms')"},"Mode":2,"TargetPropertyName":"Value"},"Maximum":{"Formula":{"Interpreter":1,"Expression":"return $prop('CarSettings_MaxRPM')\r\n"},"Mode":2,"TargetPropertyName":"Maximum"},"GaugeColor":{"Formula":{"Interpreter":1,"Expression":"//if ( $prop('Rpms') >= $prop('CarSettings_RedLineRPM') ) return 'Red';\r\n//$prop('CarSettings_CurrentGearRedLineRPM')\r\nif ( $prop('Rpms') * 1.0234375 >= $prop('CarSettings_MaxRPM') ) return 'Red';\r\nif ( $prop('Rpms') > $prop('CarSettings_CurrentGearRedLineRPM') ) return 'Gold';\r\n//if ( $prop('CarSettings_RPMShiftLight2') ) return 'DarkGreen'\r\n//if ( $prop('CarSettings_RPMShiftLight1') ) return 'ForestGreen'\r\nreturn 'LimeGreen';"},"Mode":2,"TargetPropertyName":"GaugeColor"},"BlinkEnabled":{"Formula":{"Interpreter":1,"Expression":"// Bug: PitLimiterOn is just enabled/disabled when in pits not when you engage/disengage the pit limiter\r\n//if ( $prop('PitLimiterOn') ) return true;\r\nreturn false;"},"Mode":2,"TargetPropertyName":"BlinkEnabled"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":10.0,"Text":"FUEL / LAPS / ECON","TextColor":"#FFFFFFFF","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":40.0,"Top":180.0,"Visible":true,"Width":100.0,"Name":"FuelLapsEconText"},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":18.0,"Text":"000","TextColor":"#FFFFA500","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":30.0,"Top":200.0,"Visible":true,"Width":40.0,"Name":"FuelValue","RenderingSkip":60,"Bindings":{"Text":{"FormatString":"0","Formula":{"Interpreter":1,"Expression":"fuel = $prop('Fuel')\r\n//unit = String($prop('FuelUnit')).toUpperCase()\r\n//if ( unit == 'GALLONS' ) return fuel * 0.2199692\r\nreturn fuel"},"Mode":2,"TargetPropertyName":"Text"},"TextColor":{"Formula":{"Interpreter":1,"Expression":"return $prop('Fuel')"},"StartColor":"#FFFF0000","EnableMiddleColor":true,"MiddleColor":"#FFFFA500","MiddleColorValue":5.0,"EndColor":"#FF7FFF00","StartColorValue":2.0,"EndColorValue":15.0,"Mode":4,"TargetPropertyName":"TextColor"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":18.0,"Text":"/","TextColor":"#FFFFA500","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":68.0,"Top":200.0,"Visible":true,"Width":10.0,"Name":"FuelLapsEconDivider1"},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":18.0,"Text":"000","TextColor":"#FFFFA500","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":78.0,"Top":200.0,"Visible":true,"Width":30.0,"Name":"LapsValue","RenderingSkip":60,"Bindings":{"Text":{"FormatString":"0","Formula":{"Interpreter":1,"Expression":"//return $prop('DataCorePlugin.Computed.Fuel_RemainingLaps') // [SimHub Bug] SimHub changes RemainingLaps based on Fuel Unit setting but it shouldn't since it has no bearing on remaining laps.\r\neconLPL = $prop('DataCorePlugin.Computed.Fuel_LitersPerLap')\r\nif ( ! econLPL || econLPL < 0.1 ) econLPL = 0.4 // ~0.1 US Gallons; 1 Litre = 3.7854117834 US Gallons\r\nfuel = $prop('Fuel')\r\nunit = String($prop('FuelUnit')).toUpperCase()\r\nif ( unit == 'GALLONS' ) econLPL *= 0.2641720524 // Imperial Gallon = 0.2199692 Litres; US Gallon = 0.2641720524 Litres\r\n//if ( econLPL < 0.1 ) econLPL = 0.1\r\nlaps = fuel / econLPL\r\nreturn Math.floor(laps)"},"Mode":2,"TargetPropertyName":"Text"},"TextColor":{"Formula":{"Interpreter":1,"Expression":"//return $prop('DataCorePlugin.Computed.Fuel_RemainingLaps') // [SimHub Bug] SimHub changes RemainingLaps based on Fuel Unit setting but it shouldn't since it has no bearing on remaining laps.\r\neconLPL = $prop('DataCorePlugin.Computed.Fuel_LitersPerLap')\r\nif ( ! econLPL ) return 5 // Middle Color\r\nfuel = $prop('Fuel')\r\nunit = String($prop('FuelUnit')).toUpperCase()\r\nif ( unit == 'GALLONS' ) econLPL *= 0.2641720524 // Imperial Gallon = 0.2199692 Litres; US Gallon = 0.2641720524 Litres\r\n//if ( econLPL < 0.1 ) econLPL = 0.1\r\nlaps = fuel / econLPL\r\nif ( ! laps ) return 5 // Middle Color\r\nreturn Math.floor(laps)\r\n\r\n\r\n"},"StartColor":"#FFFF0000","EnableMiddleColor":true,"MiddleColor":"#FFFFA500","MiddleColorValue":5.0,"EndColor":"#FF7FFF00","StartColorValue":2.0,"EndColorValue":15.0,"Mode":4,"TargetPropertyName":"TextColor"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":18.0,"Text":"/","TextColor":"#FFFFA500","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":106.0,"Top":200.0,"Visible":true,"Width":10.0,"Name":"FuelLapsEconDivider2"},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":18.0,"Text":"0.0","TextColor":"#FFFFA500","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":114.0,"Top":200.0,"Visible":true,"Width":30.0,"Name":"FuelEconValue","RenderingSkip":60,"Bindings":{"Text":{"FormatString":"0.0","Formula":{"Interpreter":1,"Expression":"econLPL = $prop('DataCorePlugin.Computed.Fuel_LitersPerLap')\r\necon = econLPL\r\nunit = String($prop('FuelUnit')).toUpperCase()\r\nif ( unit == 'GALLONS' ) econ *= 0.2641720524 // Imperial Gallon = 0.2199692 Litres; US Gallon = 0.2641720524 Litres\r\necon = Math.round(econ * 10) / 10\r\nif ( econ < 0.1 ) econ = 0.1\r\nreturn econ"},"Mode":2,"TargetPropertyName":"Text"}}}]}],"SnapToGrid":true,"HideLabels":true,"ShowForeground":true,"ForegroundOpacity":100.0,"ShowBackground":true,"BackgroundOpacity":100.0,"ShowBoundingRectangles":false,"GridSize":10,"Images":[],"Metadata":{"Title":"SHO XD Style Dash Mini Plus SimHub Overlay","Author":"Shovas","ScreenCount":1.0,"InGameScreensIndexs":[0],"IdleScreensIndexs":[],"MainPreviewIndex":0,"IsOverlay":true,"Width":360.0,"Height":240.0,"OverlaySizeWarning":false,"MetadataVersion":2.0,"EnableOnDashboardMessaging":true,"PitScreensIndexs":[]},"ShowOnScreenControls":true,"IsOverlay":true,"EnableClickThroughOverlay":true,"EnableOnDashboardMessaging":true}