{"DashboardDebugManager":{"LastPlacement":"1469,913,360,240","Maximized":false},"Version":2,"Id":"6326dfd4-cb34-4fa2-b73c-db6a0317449b","BaseHeight":240,"BaseWidth":360,"BackgroundColor":"#FF000000","Screens":[{"Name":"Screen1","InGameScreen":true,"IdleScreen":false,"PitScreen":false,"ScreenId":"69afe26d-2f5b-41c5-9add-aed120894178","AllowOverlays":true,"IsForegroundLayer":false,"IsOverlayLayer":false,"OverlayTriggerExpression":{"Expression":""},"OverlayMaxDuration":0,"OverlayMinDuration":0,"IsBackgroundLayer":false,"BackgroundColor":"#00FFFFFF","Items":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins","IsRectangleItem":true,"BackgroundColor":"#FF000000","BorderStyle":{"BorderColor":"#00FFFFFF","RadiusTopLeft":6,"RadiusTopRight":6,"RadiusBottomLeft":6,"RadiusBottomRight":6},"Height":240.0,"Left":0.0,"Opacity":50.0,"Top":0.0,"Visible":true,"Width":480.0,"Name":"BGRect"},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins","IsRectangleItem":true,"Rotation":270.0,"BackgroundColor":"#00FFFFFF","Height":20.0,"Left":-90.0,"Top":110.0,"Visible":true,"Width":220.0,"Name":"RpmLeftActuatedRect","Bindings":{"BackgroundColor":{"Formula":{"Interpreter":1,"Expression":"if ( $prop('EngineIgnitionOn') ) return 'DimGray'\r\n//if ( $prop('EngineStarted') && $prop('Rpms') > 0 ) return 'DimGray'\r\nreturn 'Transparent'"},"Mode":2,"TargetPropertyName":"BackgroundColor"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.LinearGaugeItem, SimHub.Plugins","IsLinearGauge":true,"GaugeOrientation":0,"GaugeAlignment":0,"AutoSize":false,"GaugeColor":"#FF32CD32","AlternateGaugeColor":"#FF008000","UseAlternateStyle":false,"Minimum":0.0,"Maximum":100.0,"Value":20.0,"Steps":0.0,"PAW":44.0,"Rotation":270.0,"BackgroundColor":"#00FFFFFF","BorderStyle":{"BorderColor":"#00FFFFFF","BorderTop":2,"BorderBottom":2,"BorderLeft":2,"BorderRight":2,"Bindings":{"BorderColor":{"Formula":{"Interpreter":1,"Expression":"//if ( $prop('Rpms') >= $prop('CarSettings_RedLineRPM') ) return 'Red';\r\n//return 'Orange';\r\nif ( $prop('EngineStarted') && $prop('Rpms') > 0 ) return 'Orange'\r\nreturn 'DimGray'"},"Mode":2,"TargetPropertyName":"BorderColor"}}},"Height":20.0,"Left":-90.0,"Top":110.0,"Visible":true,"BlinkDelay":750.0,"Width":220.0,"Name":"RpmLeftLinearGauge","Bindings":{"Value":{"Formula":{"Interpreter":1,"Expression":"//return $prop('MaxSpeedKmh')\r\n//$prop('CarSettings_MaxRPM')\r\n//$prop('CarSettings_RedLineRPM')\r\nreturn $prop('Rpms')"},"Mode":2,"TargetPropertyName":"Value"},"Maximum":{"Formula":{"Interpreter":1,"Expression":"return $prop('CarSettings_MaxRPM')\r\n"},"Mode":2,"TargetPropertyName":"Maximum"},"GaugeColor":{"Formula":{"Interpreter":1,"Expression":"//if ( $prop('Rpms') >= $prop('CarSettings_RedLineRPM') ) return 'Red';\r\n//$prop('CarSettings_CurrentGearRedLineRPM')\r\nif ( $prop('Rpms') * 1.0234375 >= $prop('CarSettings_MaxRPM') ) return 'Red';\r\nif ( $prop('Rpms') > $prop('CarSettings_CurrentGearRedLineRPM') ) return 'Gold';\r\n//if ( $prop('CarSettings_RPMShiftLight2') ) return 'DarkGreen'\r\n//if ( $prop('CarSettings_RPMShiftLight1') ) return 'ForestGreen'\r\nreturn 'LimeGreen';"},"Mode":2,"TargetPropertyName":"GaugeColor"},"BlinkEnabled":{"Formula":{"Interpreter":1,"Expression":"// Bug: PitLimiterOn is just enabled/disabled when in pits not when you engage/disengage the pit limiter\r\n//if ( $prop('PitLimiterOn') ) return true;\r\nreturn false;"},"Mode":2,"TargetPropertyName":"BlinkEnabled"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":10.0,"Text":"POSITION","TextColor":"#FFFFFFFF","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":40.0,"Top":10.0,"Visible":true,"Width":100.0,"Name":"PositionText"},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.BuiltIn.RacePositionText, SimHub.Plugins","Format":