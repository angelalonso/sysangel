              "BorderRight": 0,
              "BorderTop": 0,
              "Id": "587fc343-d8ee-4005-8e04-5c528d99e03f",
              "IsFreezed": false,
              "IsSelected": false,
              "Name": "RearIndicatorEllipse",
              "RenderingSkip": 0,
              "Sid": 0,
              "Bindings": {
                "$id": "73",
                "EllipseColor": {
                  "$id": "74",
                  "Formula": {
                    "$id": "75",
                    "Interpreter": 1,
                    "Expression": "//if ( $prop('SpotterCarLeftAngle') ) return false // Covered by left/right indicators\r\n//if ( $prop('SpotterCarRightAngle') ) return false // Covered by left/right indicators\r\n\r\n//let ret = 'Transparent'\r\n//let gap = Math.abs($prop('PersistantTrackerPlugin.DriverBehind_00_Gap'))\r\n//if ( gap > 0.2 && gap < 0.4 ) ret = 'Red'\r\n//if ( gap > 0.4 && gap < 0.8 ) ret = 'Orange'\r\n//if ( gap > 0.8 && gap < 1.2 ) ret = 'White'\r\n//return ret\r\n\r\nlet gap = Math.abs($prop('PersistantTrackerPlugin.DriverBehind_00_Gap'))\r\nif ( ! gap ) return 999\r\nif ( gap < 0.2 ) return 999 // Display left/right indicator if within 0.2s instead of rear indicator\r\nreturn gap\r\n"
                  },
                  "StartColor": "#FFFF0000",
                  "EnableMiddleColor": false,
                  "MiddleColor": "#FFFFFFFF",
                  "MiddleColorValue": 1.2,
                  "EndColor": "#00FFFFFF",
                  "StartColorValue": 0.2,
                  "EndColorValue": 1.5,
                  "Mode": 4,
                  "TargetPropertyName": "EllipseColor"
                },
                "BlinkDelay": {
                  "$id": "76",
                  "Formula": {
                    "$id": "77",
                    "Interpreter": 1,
                    "Expression": "return 250\r\n//gap = Math.abs($prop('PersistantTrackerPlugin.DriverBehind_00_Gap'))\r\n//if ( ! gap ) return 250\r\n//if ( gap > 0.2 && gap < 0.4 ) return 250\r\n//if ( gap > 0.4 && gap < 0.8 ) return 500\r\n//if ( gap > 0.8 && gap < 1.2 ) return 750\r\n//return 250"
                  },
                  "Mode": 2,
                  "TargetPropertyName": "BlinkDelay"
                },
                "BlinkEnabled": {
                  "$id": "78",
                  "Formula": {
