              "Opacity": 50.0,
              "Top": 390.0,
              "Visible": false,
              "BlinkDelay": 250.0,
              "BlinkEnabled": false,
              "Width": 800.0,
              "BorderBottom": 0,
              "BorderColor": "#00FFFFFF",
              "BorderLeft": 0,
              "BorderRight": 0,
              "BorderTop": 0,
              "Id": "5339e971-4aa8-4801-b1af-766341c84446",
              "IsFreezed": true,
              "IsSelected": false,
              "Name": "RearIndicatorRect",
              "RenderingSkip": 0,
              "Sid": 0,
              "Bindings": {
                "$id": "63",
                "BackgroundColor": {
                  "$id": "64",
                  "Formula": {
                    "$id": "65",
                    "Interpreter": 1,
                    "Expression": "//if ( $prop('SpotterCarLeftAngle') ) return false // Covered by left/right indicators\r\n//if ( $prop('SpotterCarRightAngle') ) return false // Covered by left/right indicators\r\n\r\ngap = Math.abs($prop('PersistantTrackerPlugin.DriverBehind_00_Gap'))\r\nif ( gap > 0.2 && gap < 0.4 ) return 'Red'\r\nif ( gap > 0.4 && gap < 0.8 ) return 'Orange'\r\nif ( gap > 0.8 && gap < 1.2 ) return 'White'\r\nreturn 'Transparent'"
                  },
                  "Mode": 2,
                  "TargetPropertyName": "BackgroundColor"
                },
                "BlinkEnabled": {
                  "$id": "66",
                  "Formula": {
                    "$id": "67",
                    "Interpreter": 1,
                    "Expression": "if ( $prop('SpotterCarLeftAngle') ) return false // Covered by left/right indicators\r\nif ( $prop('SpotterCarRightAngle') ) return false // Covered by left/right indicators\r\n\r\ngap = Math.abs($prop('PersistantTrackerPlugin.DriverBehind_00_Gap'))\r\nif ( gap > 0.2 && gap < 1.2 ) return true\r\nreturn false"
                  },
                  "Mode": 2,
                  "TargetPropertyName": "BlinkEnabled"
                },
                "BlinkDelay": {
                  "$id": "68",
                  "Formula": {
                    "$id": "69",
                    "Interpreter": 1,
                    "Expression": "gap = Math.abs($prop('PersistantTrackerPlugin.DriverBehind_00_Gap'))\r\nif ( gap > 0.2 && gap < 0.4 ) return 250\r\nif ( gap > 0.4 && gap < 0.8 ) return 500\r\nif ( gap > 0.8 && gap < 1.2 ) return 750\r\nreturn 250"
                  },
                  "Mode": 2,
                  "TargetPropertyName": "BlinkDelay"
                }
              }
            },
            {
              "$id": "70",
              "$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.EllipseItem, SimHub.Plugins",
