{"DashboardDebugManager":{"LastPlacement":"1980,13,470,164","Maximized":false},"Version":2,"Id":"406579a4-504c-4838-a4db-602eccbdd933","BaseHeight":164,"BaseWidth":470,"BackgroundColor":"#FF000000","Screens":[{"Name":"Screen1","InGameScreen":true,"IdleScreen":false,"PitScreen":false,"ScreenId":"2a5a6982-a3fa-437f-b94d-1ba43dc80f9d","AllowOverlays":true,"IsForegroundLayer":false,"IsOverlayLayer":false,"OverlayTriggerExpression":{"Expression":""},"OverlayMaxDuration":0,"OverlayMinDuration":0,"IsBackgroundLayer":false,"BackgroundColor":"#00FFFFFF","Items":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins","IsRectangleItem":true,"BackgroundColor":"#FF000000","BorderStyle":{"RadiusTopLeft":6,"RadiusTopRight":6,"RadiusBottomLeft":6,"RadiusBottomRight":6},"Height":164.0,"Left":0.0,"Opacity":50.0,"Top":0.0,"Visible":true,"Width":470.0,"Name":"BGRect","RenderingSkip":60},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":30.0,"Text":"SECTOR","TextColor":"#FFFFFFFF","HorizontalAlignment":0,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":10.0,"Top":0.0,"Visible":true,"Width":115.0,"Name":"SectorText","RenderingSkip":60},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":30.0,"Text":"0","TextColor":"#FFFFFFFF","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":10.0,"Top":0.0,"Visible":true,"Width":145.0,"Name":"Sector0TimeText","RenderingSkip":60,"Bindings":{"TextColor":{"Formula":{"Interpreter":1,"Expression":"// Always gray in pit\r\nif ( $prop('IsInPit') ) return 'Gray'\r\n\r\nreturn 'White'"},"Mode":2,"TargetPropertyName":"TextColor"},"Text":{"Formula":{"Interpreter":1,"Expression":"// Session reset logic: Session restarted, SimHub replay rewind, etc.\r\nif ( root['SessionTimeLeft'] && timespantoseconds($prop('SessionTimeLeft')) > timespantoseconds(root['SessionTimeLeft']) ) {\r\n\tfor ( var key in root ) delete root[key]\r\n}\r\nroot['SessionTimeLeft'] = $prop('SessionTimeLeft')\r\n\r\n// State tracking\r\nif ( ! root['sectorCount'] || $prop('CurrentSectorIndex') > root['sectorCount'] ) root['sectorCount'] = $prop('CurrentSectorIndex')\r\nif ( root['sectorCount'] > 1 && $prop('CurrentSectorIndex') == 1 ) root['finalSectorIndex'] = root['sectorCount']\r\n\r\n// Setup\r\nlet sectorIndex = $prop('CurrentSectorIndex')\r\nif ( root['finalSectorIndex'] && sectorIndex < 1 ) sectorIndex = root['finalSectorIndex'] + sectorIndex\r\nif ( sectorIndex < 1 ) return ''\r\nlet lastLapSector = ( sectorIndex >= $prop('CurrentSectorIndex') ) ? true : false\r\nlet nextSectorIndex = sectorIndex + 1 \r\nif ( root['finalSectorIndex'] && nextSectorIndex > root['finalSectorIndex'] ) nextSectorIndex = 1\r\n\r\nreturn sectorIndex"},"Mode":2,"TargetPropertyName":"Text"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":30.0,"Text":"-","TextColor":"#FFFFA500","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":155.0,"Top":0.0,"Visible":false,"Width":150.0,"IsFreezed":true,"Name":"Sector0Value","RenderingSkip":60,"Bindings":{"Text":{"Formula":{"Interpreter":1,"Expression":"return $prop('CurrentSectorIndex')"},"Mode":2,"TargetPropertyName":"Text"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":30.0,"Text":"--:--.---","TextColor":"#FFFFA500","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":155.0,"Top":0.0,"Visible":true,"Width":150.0,"Name":"Sector0TimeValue","RenderingSkip":60,"Bindings":{"Text":{"FormatString":"m\\:ss\\.fff","Formula":{"Interpreter":1,"Expression":"// Session reset logic: Session restarted, SimHub replay rewind, etc.\r\nif ( root['SessionTimeLeft'] && timespantoseconds($prop('SessionTimeLeft')) > timespantoseconds(root['SessionTimeLeft']) ) {\r\n\tfor ( var key in root ) delete root[key]\r\n}\r\nroot['SessionTimeLeft'] = $prop('SessionTimeLeft')\r\n\r\n// State tracking\r\nif ( ! root['sectorCount'] || $prop('CurrentSectorIndex') > root['sectorCount'] ) root['sectorCount'] = $prop('CurrentSectorIndex')\r\nif ( root['sectorCount'] > 1 && $prop('CurrentSectorIndex') == 1 ) root['finalSectorIndex'] = root['sectorCount']\r\n\r\n// Always default in pit\r\nif ( $prop('IsInPit') ) return '--:--.---'\r\n\r\n// Setup\r\nlet sectorOffset = 0 // Update me\r\nlet sectorIndex = $prop('CurrentSectorIndex') + sectorOffset\r\nif ( root['finalSectorIndex'] && sectorIndex < 1 ) sectorIndex = root['finalSectorIndex'] + sectorIndex\r\nif ( sectorIndex < 1 ) return '--:--.---'\r\nlet nextSectorIndex = sectorIndex + 1 \r\nif ( root['finalSectorIndex'] && nextSectorIndex > root['finalSectorIndex'] ) nextSectorIndex = 1\r\n\r\n// Normal case when not final sector\r\nlet sectorTimeKey = 'Sector' + sectorIndex + 'Time'\r\nif ( $prop(sectorTimeKey) ) return $prop(sectorTimeKey)\r\n\r\n// Handle final sector\r\nif ( ! root['finalSectorIndex'] ) return '--:--.---'\r\nif ( sectorIndex == root['finalSectorIndex'] ) {\r\n\tlet sectorTimeKey = 'Sector' + sectorIndex + 'LastLapTime'\r\n\tif ( $prop(sectorTimeKey) ) return $prop(sectorTimeKey)\r\n\treturn '--:--.---'\r\n}\r\n\r\nreturn '--:--.---'"},"Mode":2,"TargetPropertyName":"Text"},"TextColor":{"Formula":{"Interpreter":1,"Expression":"// Session reset logic: Session restarted, SimHub replay rewind, etc.\r\nif ( root['SessionTimeLeft'] && timespantoseconds($prop('SessionTimeLeft')) > timespantoseconds(root['SessionTimeLeft']) ) {\r\n\tfor ( var key in root ) delete root[key]\r\n}\r\nroot['SessionTimeLeft'] = $prop('SessionTimeLeft')\r\n\r\n// State tracking\r\nif ( ! root['sectorCount'] || $prop('CurrentSectorIndex') > root['sectorCount'] ) root['sectorCount'] = $prop('CurrentSectorIndex')\r\nif ( root['sectorCount'] > 1 && $prop('CurrentSectorIndex') == 1 ) root['finalSectorIndex'] = root['sectorCount']\r\n\r\n// Always gray in pit\r\nif ( $prop('IsInPit') ) return 'Gray'\r\n\r\n// Return now until we have final sector count\r\nif ( ! root['finalSectorIndex'] ) return 'Gray'\r\n\r\n// Setup\r\nlet sectorOffset = 0 // Update me\r\nlet sectorIndex = $prop('CurrentSectorIndex') + sectorOffset\r\nif ( sectorIndex < 1 ) sectorIndex = root['finalSectorIndex'] + sectorIndex\r\nif ( sectorIndex < 1 ) return 'Gray'\r\nlet lastLapSector = ( sectorIndex >= $prop('CurrentSectorIndex') ) ? true : false\r\nlet nextSectorIndex = sectorIndex + 1 \r\nif ( nextSectorIndex > root['finalSectorIndex'] ) nextSectorIndex = 1\r\nlet prevSectorIndex = sectorIndex - 1\r\nif ( sectorIndex < 1 ) prevSectorIndex = root['finalSectorIndex']\r\nlet sectorLap = $prop('CurrentLap')\r\nif ( lastLapSector ) sectorLap--\r\n\r\n// Generate keys\r\nlet sectorBestTimeKey = 'Sector' + sectorIndex + 'BestTime'\r\nlet sectorTimeKey = 'Sector' + sectorIndex + 'Time'\r\nif ( sectorIndex == root['finalSectorIndex'] ) {\r\n\tsectorTimeKey = 'Sector' + sectorIndex + 'LastLapTime'\r\n}\r\n\r\n// Return if data not ready yet\r\nif ( ! $prop(sectorTimeKey) ) return 'Gray'\r\n\r\nreturn 'Orange' // No deltas shown on first row"},"Mode":2,"TargetPropertyName":"TextColor"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":30.0,"Text":"-","TextColor":"#FFFFA500","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":310.0,"Top":0.0,"Visible":true,"Width":150.0,"Name":"Sector0DeltaValue","RenderingSkip":60,"Bindings":{"Text":{"Formula":{"Interpreter":1,"Expression":"return '-' // No delta shown on first row"},"Mode":2,"TargetPropertyName":"Text"},"TextColor":{"Formula":{"Interpreter":1,"Expression":"// Session reset logic: Session restarted, SimHub replay rewind, etc.\r\nif ( root['SessionTimeLeft'] && timespantoseconds($prop('SessionTimeLeft')) > timespantoseconds(root['SessionTimeLeft']) ) {\r\n\tfor ( var key in root ) delete root[key]\r\n}\r\nroot['SessionTimeLeft'] = $prop('SessionTimeLeft')\r\n\r\n// State tracking\r\nif ( ! root['sectorCount'] || $prop('CurrentSectorIndex') > root['sectorCount'] ) root['sectorCount'] = $prop('CurrentSectorIndex')\r\nif ( root['sectorCount'] > 1 && $prop('CurrentSectorIndex') == 1 ) root['finalSectorIndex'] = root['sectorCount']\r\n\r\n// Always gray in pit\r\nif ( $prop('IsInPit') ) return 'Gray'\r\n\r\n// Return now until we have final sector count\r\nif ( ! root['finalSectorIndex'] ) return 'Gray'\r\n\r\n// Setup\r\nlet sectorOffset = 0 // Update me\r\nlet sectorIndex = $prop('CurrentSectorIndex') + sectorOffset\r\nif ( sectorIndex < 1 ) sectorIndex = root['finalSectorIndex'] + sectorIndex\r\nif ( sectorIndex < 1 ) return 'Gray'\r\nlet lastLapSector = ( sectorIndex >= $prop('CurrentSectorIndex') ) ? true : false\r\nlet nextSectorIndex = sectorIndex + 1 \r\nif ( nextSectorIndex > root['finalSectorIndex'] ) nextSectorIndex = 1\r\nlet prevSectorIndex = sectorIndex - 1\r\nif ( sectorIndex < 1 ) prevSectorIndex = root['finalSectorIndex']\r\nlet sectorLap = $prop('CurrentLap')\r\nif ( lastLapSector ) sectorLap--\r\n\r\n// Generate keys\r\nlet sectorBestTimeKey = 'Sector' + sectorIndex + 'BestTime'\r\nlet sectorTimeKey = 'Sector' + sectorIndex + 'Time'\r\nif ( sectorIndex == root['finalSectorIndex'] ) {\r\n\tsectorTimeKey = 'Sector' + sectorIndex + 'LastLapTime'\r\n}\r\n\r\n// Return if data not ready yet\r\nif ( ! $prop(sectorTimeKey) ) return 'Gray'\r\n\r\nreturn 'Orange' // No deltas shown on first row"},"Mode":2,"TargetPropertyName":"TextColor"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins","IsRectangleItem":true,"BackgroundColor":"#FF808080","Height":2.0,"Left":10.0,"Top":40.0,"Visible":true,"Width":450.0,"Name":"DividerRect","RenderingSkip":60},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":30.0,"Text":"-1","TextColor":"#FFFFFFFF","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":10.0,"Top":40.0,"Visible":true,"Width":145.0,"Name":"Sector1TimeText","RenderingSkip":60,"Bindings":{"TextColor":{"Formula":{"Interpreter":1,"Expression":"// Session reset logic: Session restarted, SimHub replay rewind, etc.\r\nif ( root['SessionTimeLeft'] && timespantoseconds($prop('SessionTimeLeft')) > timespantoseconds(root['SessionTimeLeft']) ) {\r\n\tfor ( var key in root ) delete root[key]\r\n}\r\nroot['SessionTimeLeft'] = $prop('SessionTimeLeft')\r\n\r\n// State tracking\r\nif ( ! root['sectorCount'] || $prop('CurrentSectorIndex') > root['sectorCount'] ) root['sectorCount'] = $prop('CurrentSectorIndex')\r\nif ( root['sectorCount'] > 1 && $prop('CurrentSectorIndex') == 1 ) root['finalSectorIndex'] = root['sectorCount']\r\n\r\n// Always gray in pit\r\nif ( $prop('IsInPit') ) return 'Gray'\r\n\r\n// Setup\r\nlet sectorOffset = -1 // Update me\r\nlet sectorIndex = $prop('CurrentSectorIndex') + sectorOffset\r\nif ( root['finalSectorIndex'] && sectorIndex < 1 ) sectorIndex = root['finalSectorIndex'] + sectorIndex\r\nif ( sectorIndex < 1 ) return 'Gray'\r\nlet lastLapSector = ( sectorIndex >= $prop('CurrentSectorIndex') ) ? true : false\r\nlet nextSectorIndex = sectorIndex + 1 \r\nif ( root['finalSectorIndex'] && nextSectorIndex > root['finalSectorIndex'] ) nextSectorIndex = 1\r\n\r\n// Always gray for last lap sectors\r\nif ( lastLapSector ) return 'Gray'\r\n\r\nreturn 'Orange'"},"Mode":2,"TargetPropertyName":"TextColor"},"Text":{"Formula":{"Interpreter":1,"Expression":"// Session reset logic: Session restarted, SimHub replay rewind, etc.\r\nif ( root['SessionTimeLeft'] && timespantoseconds($prop('SessionTimeLeft')) > timespantoseconds(root['SessionTimeLeft']) ) {\r\n\tfor ( var key in root ) delete root[key]\r\n}\r\nroot['SessionTimeLeft'] = $prop('SessionTimeLeft')\r\n\r\n// State tracking\r\nif ( ! root['sectorCount'] || $prop('CurrentSectorIndex') > root['sectorCount'] ) root['sectorCount'] = $prop('CurrentSectorIndex')\r\nif ( root['sectorCount'] > 1 && $prop('CurrentSectorIndex') == 1 ) root['finalSectorIndex'] = root['sectorCount']\r\n\r\n// Setup\r\nlet sectorOffset = -1 // Update me\r\nlet sectorIndex = $prop('CurrentSectorIndex') + sectorOffset\r\nif ( root['finalSectorIndex'] && sectorIndex < 1 ) sectorIndex = root['finalSectorIndex'] + sectorIndex\r\nif ( sectorIndex < 1 ) return ''\r\nlet lastLapSector = ( sectorIndex >= $prop('CurrentSectorIndex') ) ? true : false\r\nlet nextSectorIndex = sectorIndex + 1 \r\nif ( root['finalSectorIndex'] && nextSectorIndex > root['finalSectorIndex'] ) nextSectorIndex = 1\r\n\r\nreturn sectorIndex"},"Mode":2,"TargetPropertyName":"Text"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":30.0,"Text":"--:--.---","TextColor":"#FFFFA500","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":155.0,"Top":40.0,"Visible":true,"Width":150.0,"Name":"Sector1TimeValue","RenderingSkip":60,"Bindings":{"Text":{"FormatString":"m\\:ss\\.fff","Formula":{"Interpreter":1,"Expression":"// Session reset logic: Session restarted, SimHub replay rewind, etc.\r\nif ( root['SessionTimeLeft'] && timespantoseconds($prop('SessionTimeLeft')) > timespantoseconds(root['SessionTimeLeft']) ) {\r\n\tfor ( var key in root ) delete root[key]\r\n}\r\nroot['SessionTimeLeft'] = $prop('SessionTimeLeft')\r\n\r\n// State tracking\r\nif ( ! root['sectorCount'] || $prop('CurrentSectorIndex') > root['sectorCount'] ) root['sectorCount'] = $prop('CurrentSectorIndex')\r\nif ( root['sectorCount'] > 1 && $prop('CurrentSectorIndex') == 1 ) root['finalSectorIndex'] = root['sectorCount']\r\n\r\n// Always default in pit\r\nif ( $prop('IsInPit') ) return '--:--.---'\r\n\r\n// Setup\r\nlet sectorOffset = -1 // Update me\r\nlet sectorIndex = $prop('CurrentSectorIndex') + sectorOffset\r\nif ( root['finalSectorIndex'] && sectorIndex < 1 ) sectorIndex = root['finalSectorIndex'] + sectorIndex\r\nif ( sectorIndex < 1 ) return '--:--.---'\r\nlet nextSectorIndex = sectorIndex + 1 \r\nif ( root['finalSectorIndex'] && nextSectorIndex > root['finalSectorIndex'] ) nextSectorIndex = 1\r\n\r\n// Normal case when not final sector\r\nlet sectorTimeKey = 'Sector' + sectorIndex + 'Time'\r\nif ( $prop(sectorTimeKey) ) return $prop(sectorTimeKey)\r\n\r\n// Handle final sector\r\nif ( ! root['finalSectorIndex'] ) return '--:--.---'\r\nif ( sectorIndex == root['finalSectorIndex'] ) {\r\n\tlet sectorTimeKey = 'Sector' + sectorIndex + 'LastLapTime'\r\n\tif ( $prop(sectorTimeKey) ) return $prop(sectorTimeKey)\r\n\treturn '--:--.---'\r\n}\r\n\r\nreturn '--:--.---'"},"Mode":2,"TargetPropertyName":"Text"},"TextColor":{"Formula":{"Interpreter":1,"Expression":"// Session reset logic: Session restarted, SimHub replay rewind, etc.\r\nif ( root['SessionTimeLeft'] && timespantoseconds($prop('SessionTimeLeft')) > timespantoseconds(root['SessionTimeLeft']) ) {\r\n\tfor ( var key in root ) delete root[key]\r\n}\r\nroot['SessionTimeLeft'] = $prop('SessionTimeLeft')\r\n\r\n// State tracking\r\nif ( ! root['sectorCount'] || $prop('CurrentSectorIndex') > root['sectorCount'] ) root['sectorCount'] = $prop('CurrentSectorIndex')\r\nif ( root['sectorCount'] > 1 && $prop('CurrentSectorIndex') == 1 ) root['finalSectorIndex'] = root['sectorCount']\r\n\r\n// Always gray in pit\r\nif ( $prop('IsInPit') ) return 'Gray'\r\n\r\n// Return now until we have final sector count\r\nif ( ! root['finalSectorIndex'] ) return 'Gray'\r\n\r\n// Setup\r\nlet sectorOffset = -1 // Update me\r\nlet sectorIndex = $prop('CurrentSectorIndex') + sectorOffset\r\nif ( sectorIndex < 1 ) sectorIndex = root['finalSectorIndex'] + sectorIndex\r\nif ( sectorIndex < 1 ) return 'Gray'\r\nlet lastLapSector = ( sectorIndex >= $prop('CurrentSectorIndex') ) ? true : false\r\nlet nextSectorIndex = sectorIndex + 1 \r\nif ( nextSectorIndex > root['finalSectorIndex'] ) nextSectorIndex = 1\r\nlet prevSectorIndex = sectorIndex - 1\r\nif ( sectorIndex < 1 ) prevSectorIndex = root['finalSectorIndex']\r\nlet sectorLap = $prop('CurrentLap')\r\nif ( lastLapSector ) sectorLap--\r\n\r\n// Generate keys\r\nlet sectorBestTimeKey = 'Sector' + sectorIndex + 'BestTime'\r\nlet sectorTimeKey = 'Sector' + sectorIndex + 'Time'\r\nif ( sectorIndex == root['finalSectorIndex'] ) {\r\n\tsectorTimeKey = 'Sector' + sectorIndex + 'LastLapTime'\r\n}\r\n\r\n// Return if data not ready yet\r\nif ( ! $prop(sectorTimeKey) ) return 'Gray'\r\n\r\nreturn 'Orange' // No deltas shown on first row"},"Mode":2,"TargetPropertyName":"TextColor"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":30.0,"Text":"-","TextColor":"#FFFFA500","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":310.0,"Top":40.0,"Visible":true,"Width":150.0,"Name":"Sector1DeltaValue","RenderingSkip":60,"Bindings":{"Text":{"Formula":{"Interpreter":1,"Expression":"// Session reset logic: Session restarted, SimHub replay rewind, etc.\r\nif ( root['SessionTimeLeft'] && timespantoseconds($prop('SessionTimeLeft')) > timespantoseconds(root['SessionTimeLeft']) ) {\r\n\tfor ( var key in root ) delete root[key]\r\n}\r\nroot['SessionTimeLeft'] = $prop('SessionTimeLeft')\r\n\r\n// State tracking\r\nif ( ! root['sectorCount'] || $prop('CurrentSectorIndex') > root['sectorCount'] ) root['sectorCount'] = $prop('CurrentSectorIndex')\r\nif ( root['sectorCount'] > 1 && $prop('CurrentSectorIndex') == 1 ) root['finalSectorIndex'] = root['sectorCount']\r\n\r\n// Return now until we have final sector count\r\nif ( ! root['finalSectorIndex'] ) return '-'\r\n\r\n// Setup\r\nlet sectorOffset = -1 // Update me\r\nlet sectorIndex = $prop('CurrentSectorIndex') + sectorOffset\r\nif ( sectorIndex < 1 ) sectorIndex = root['finalSectorIndex'] + sectorIndex\r\nif ( sectorIndex < 1 ) return '-'\r\nlet lastLapSector = ( sectorIndex >= $prop('CurrentSectorIndex') ) ? true : false\r\nlet nextSectorIndex = sectorIndex + 1 \r\nif ( nextSectorIndex > root['finalSectorIndex'] ) nextSectorIndex = 1\r\nlet prevSectorIndex = sectorIndex - 1\r\nif ( sectorIndex < 1 ) prevSectorIndex = root['finalSectorIndex']\r\nlet sectorLap = $prop('CurrentLap')\r\nif ( lastLapSector ) sectorLap--\r\n\r\n// Generate keys\r\nlet sectorBestTimeKey = 'Sector' + sectorIndex + 'BestTime'\r\nlet sectorTimeKey = 'Sector' + sectorIndex + 'Time'\r\nif ( sectorIndex == root['finalSectorIndex'] ) {\r\n\tsectorTimeKey = 'Sector' + sectorIndex + 'LastLapTime'\r\n}\r\nlet oldSectorDeltaStrKey = 'oldSector' + sectorIndex + 'Lap' + sectorLap + 'DeltaStr'\r\n\r\n// Return if data not ready yet\r\nif ( ! $prop(sectorTimeKey) ) return '-'\r\n\r\n// Store Sector*BestTime while in its sector because Sector*BestTime gets overwritten as soon as you finish the sector with a new best time so this allows us to compare\r\n// - Best times are updated with the new best time below after deltas are generated\r\nlet currentSectorBestTimeKey = 'Sector' + $prop('CurrentSectorIndex') + 'BestTime'\r\nlet currentSectorBestTime = $prop(currentSectorBestTimeKey)\r\nif ( ! root[currentSectorBestTimeKey] ) root[currentSectorBestTimeKey] = $prop(currentSectorBestTimeKey)\r\n\r\n// Always generate previous sector's delta if not done yet\r\nlet targetSectorIndex = $prop('CurrentSectorIndex') - 1\r\nlet targetSectorLap = $prop('CurrentLap')\r\nif ( targetSectorIndex < 1 ) {\r\n\ttargetSectorIndex = root['finalSectorIndex']\r\n\ttargetSectorLap--\r\n}\r\nlet targetSectorBestTimeKey = 'Sector' + targetSectorIndex + 'BestTime'\r\nlet targetSectorTimeKey = 'Sector' + targetSectorIndex + 'Time'\r\nif ( targetSectorIndex == root['finalSectorIndex'] ) {\r\n\ttargetSectorTimeKey = 'Sector' + targetSectorIndex + 'LastLapTime'\r\n}\r\nlet targetOldSectorDeltaStrKey = 'oldSector' + targetSectorIndex + 'Lap' + targetSectorLap + 'DeltaStr'\r\n\r\n// Wait for valid data to generate delta\r\nif ( ! $prop(targetSectorTimeKey) ) return '-'\r\n\r\n// Generate deltas\r\nif ( ! root[targetOldSectorDeltaStrKey] ) {\r\n\t// Compare new time to old best time\r\n\t// - Newest sector time\r\n\tlet s = $prop(targetSectorTimeKey)\r\n\tlet sSec = timespantoseconds(s)\r\n\t// - Best sector time\r\n\t//let sb = $prop(targetSectorBestTimeKey)\r\n\tlet sb = root[targetSectorBestTimeKey]\r\n\tlet sbSec = timespantoseconds(sb)\r\n\t// - Generate delta\r\n\tif ( sSec && sbSec ) {\r\n\t\tlet delta = sSec - sbSec\r\n\t\tlet deltats = secondstotimespan(delta)\r\n\t\tlet deltaStr = '-' // Handle no delta which shouldn't show +/-\r\n\t\tif ( delta ) deltaStr = toshorttime(deltats, 3, true) // ie. +/- 0.000\r\n\t\troot[targetOldSectorDeltaStrKey] = deltaStr\r\n\t}\r\n}\r\n\r\n// Always refresh sector best times after deltas are generated\r\nroot[currentSectorBestTimeKey] = $prop(currentSectorBestTimeKey)\r\n\r\n// Return old value if already generated\r\nif ( root[oldSectorDeltaStrKey] ) return root[oldSectorDeltaStrKey]\r\n\r\nreturn '-'"},"Mode":2,"TargetPropertyName":"Text"},"TextColor":{"Formula":{"Interpreter":1,"Expression":"// Session reset logic: Session restarted, SimHub replay rewind, etc.\r\nif ( root['SessionTimeLeft'] && timespantoseconds($prop('SessionTimeLeft')) > timespantoseconds(root['SessionTimeLeft']) ) {\r\n\tfor ( var key in root ) delete root[key]\r\n}\r\nroot['SessionTimeLeft'] = $prop('SessionTimeLeft')\r\n\r\n// State tracking\r\nif ( ! root['sectorCount'] || $prop('CurrentSectorIndex') > root['sectorCount'] ) root['sectorCount'] = $prop('CurrentSectorIndex')\r\nif ( root['sectorCount'] > 1 && $prop('CurrentSectorIndex') == 1 ) root['finalSectorIndex'] = root['sectorCount']\r\n\r\n// Return now until we have final sector count\r\nif ( ! root['finalSectorIndex'] ) return 'Gray'\r\n\r\n// Setup\r\nlet sectorOffset = -1 // Update me\r\nlet sectorIndex = $prop('CurrentSectorIndex') + sectorOffset\r\nif ( sectorIndex < 1 ) sectorIndex = root['finalSectorIndex'] + sectorIndex\r\nif ( sectorIndex < 1 ) return 'Gray'\r\nlet lastLapSector = ( sectorIndex >= $prop('CurrentSectorIndex') ) ? true : false\r\nlet nextSectorIndex = sectorIndex + 1 \r\nif ( nextSectorIndex > root['finalSectorIndex'] ) nextSectorIndex = 1\r\nlet prevSectorIndex = sectorIndex - 1\r\nif ( sectorIndex < 1 ) prevSectorIndex = root['finalSectorIndex']\r\nlet sectorLap = $prop('CurrentLap')\r\nif ( lastLapSector ) sectorLap--\r\n\r\n// Generate keys\r\nlet sectorBestTimeKey = 'Sector' + sectorIndex + 'BestTime'\r\nlet sectorTimeKey = 'Sector' + sectorIndex + 'Time'\r\nif ( sectorIndex == root['finalSectorIndex'] ) {\r\n\tsectorTimeKey = 'Sector' + sectorIndex + 'LastLapTime'\r\n}\r\nlet oldSectorDeltaColorKey = 'oldSector' + sectorIndex + 'Lap' + sectorLap + 'DeltaColor'\r\n\r\n// Return if data not ready yet\r\nif ( ! $prop(sectorTimeKey) ) return 'Gray'\r\n\r\n// Store Sector*BestTime while in its sector because Sector*BestTime gets overwritten as soon as you finish the sector with a new best time so this allows us to compare\r\n// - Best times are updated with the new best time below after deltas are generated\r\nlet currentSectorBestTimeKey = 'Sector' + $prop('CurrentSectorIndex') + 'BestTime'\r\nlet currentSectorBestTime = $prop(currentSectorBestTimeKey)\r\nif ( ! root[currentSectorBestTimeKey] ) root[currentSectorBestTimeKey] = $prop(currentSectorBestTimeKey)\r\n\r\n// Always generate previous sector's delta if not done yet\r\nlet targetSectorIndex = $prop('CurrentSectorIndex') - 1\r\nlet targetSectorLap = $prop('CurrentLap')\r\nif ( targetSectorIndex < 1 ) {\r\n\ttargetSectorIndex = root['finalSectorIndex']\r\n\ttargetSectorLap--\r\n}\r\nlet targetSectorBestTimeKey = 'Sector' + targetSectorIndex + 'BestTime'\r\nlet targetSectorTimeKey = 'Sector' + targetSectorIndex + 'Time'\r\nif ( targetSectorIndex == root['finalSectorIndex'] ) {\r\n\ttargetSectorTimeKey = 'Sector' + targetSectorIndex + 'LastLapTime'\r\n}\r\nlet targetOldSectorDeltaColorKey = 'oldSector' + targetSectorIndex + 'Lap' + targetSectorLap + 'DeltaColor'\r\n\r\n// Wait for valid data to generate delta\r\nif ( ! $prop(targetSectorTimeKey) ) return 'Gray'\r\n\r\n// Generate deltas\r\nif ( ! root[targetOldSectorDeltaColorKey] ) {\r\n\t// Compare new time to old best time\r\n\t// - Newest sector time\r\n\tlet s = $prop(targetSectorTimeKey)\r\n\tlet sSec = timespantoseconds(s)\r\n\t// - Best sector time\r\n\t//let sb = $prop(targetSectorBestTimeKey)\r\n\tlet sb = root[targetSectorBestTimeKey]\r\n\tlet sbSec = timespantoseconds(sb)\r\n\t// - Generate delta\r\n\tif ( sSec && sbSec ) {\r\n\t\tlet delta = sSec - sbSec\r\n\t\tlet deltats = secondstotimespan(delta)\r\n\t\tdeltaColor = 'Orange'\r\n\t\tif ( delta ) {\r\n\t\t if ( delta < 0 ) deltaColor = 'LimeGreen'\r\n\t\t if ( delta > 0 ) deltaColor = 'Red'\r\n\t\t}\r\n\t\troot[targetOldSectorDeltaColorKey] = deltaColor\r\n\t}\r\n}\r\n\r\n// Always refresh sector best times after deltas are generated\r\nroot[currentSectorBestTimeKey] = $prop(currentSectorBestTimeKey)\r\n\r\n// Return old value if already generated\r\nif ( root[oldSectorDeltaColorKey] ) return root[oldSectorDeltaColorKey]\r\n\r\nreturn 'Orange'"},"Mode":2,"TargetPropertyName":"TextColor"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":30.0,"Text":"-2","TextColor":"#FFFFFFFF","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":10.0,"Top":80.0,"Visible":true,"Width":145.0,"Name":"Sector2TimeText","RenderingSkip":60,"Bindings":{"TextColor":{"Formula":{"Interpreter":1,"Expression":"// Session reset logic: Session restarted, SimHub replay rewind, etc.\r\nif ( root['SessionTimeLeft'] && timespantoseconds($prop('SessionTimeLeft')) > timespantoseconds(root['SessionTimeLeft']) ) {\r\n\tfor ( var key in root ) delete root[key]\r\n}\r\nroot['SessionTimeLeft'] = $prop('SessionTimeLeft')\r\n\r\n// State tracking\r\nif ( ! root['sectorCount'] || $prop('CurrentSectorIndex') > root['sectorCount'] ) root['sectorCount'] = $prop('CurrentSectorIndex')\r\nif ( root['sectorCount'] > 1 && $prop('CurrentSectorIndex') == 1 ) root['finalSectorIndex'] = root['sectorCount']\r\n\r\n// Always gray in pit\r\nif ( $prop('IsInPit') ) return 'Gray'\r\n\r\n// Setup\r\nlet sectorOffset = -2 // Update me\r\nlet sectorIndex = $prop('CurrentSectorIndex') + sectorOffset\r\nif ( root['finalSectorIndex'] && sectorIndex < 1 ) sectorIndex = root['finalSectorIndex'] + sectorIndex\r\nif ( sectorIndex < 1 ) return 'Gray'\r\nlet lastLapSector = ( sectorIndex >= $prop('CurrentSectorIndex') ) ? true : false\r\nlet nextSectorIndex = sectorIndex + 1 \r\nif ( root['finalSectorIndex'] && nextSectorIndex > root['finalSectorIndex'] ) nextSectorIndex = 1\r\n\r\n// Always gray for last lap sectors\r\nif ( lastLapSector ) return 'Gray'\r\n\r\nreturn 'Orange'"},"Mode":2,"TargetPropertyName":"TextColor"},"Text":{"Formula":{"Interpreter":1,"Expression":"// Session reset logic: Session restarted, SimHub replay rewind, etc.\r\nif ( root['SessionTimeLeft'] && timespantoseconds($prop('SessionTimeLeft')) > timespantoseconds(root['SessionTimeLeft']) ) {\r\n\tfor ( var key in root ) delete root[key]\r\n}\r\nroot['SessionTimeLeft'] = $prop('SessionTimeLeft')\r\n\r\n// State tracking\r\nif ( ! root['sectorCount'] || $prop('CurrentSectorIndex') > root['sectorCount'] ) root['sectorCount'] = $prop('CurrentSectorIndex')\r\nif ( root['sectorCount'] > 1 && $prop('CurrentSectorIndex') == 1 ) root['finalSectorIndex'] = root['sectorCount']\r\n\r\n// Setup\r\nlet sectorOffset = -2 // Update me\r\nlet sectorIndex = $prop('CurrentSectorIndex') + sectorOffset\r\nif ( root['finalSectorIndex'] && sectorIndex < 1 ) sectorIndex = root['finalSectorIndex'] + sectorIndex\r\nif ( sectorIndex < 1 ) return ''\r\nlet lastLapSector = ( sectorIndex >= $prop('CurrentSectorIndex') ) ? true : false\r\nlet nextSectorIndex = sectorIndex + 1 \r\nif ( root['finalSectorIndex'] && nextSectorIndex > root['finalSectorIndex'] ) nextSectorIndex = 1\r\n\r\nreturn sectorIndex"},"Mode":2,"TargetPropertyName":"Text"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":30.0,"Text":"--:--.---","TextColor":"#FFFFA500","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":155.0,"Top":80.0,"Visible":true,"Width":150.0,"Name":"Sector2TimeValue","RenderingSkip":60,"Bindings":{"Text":{"FormatString":"m\\:ss\\.fff","Formula":{"Interpreter":1,"Expression":"// Session reset logic: Session restarted, SimHub replay rewind, etc.\r\nif ( root['SessionTimeLeft'] && timespantoseconds($prop('SessionTimeLeft')) > timespantoseconds(root['SessionTimeLeft']) ) {\r\n\tfor ( var key in root ) delete root[key]\r\n}\r\nroot['SessionTimeLeft'] = $prop('SessionTimeLeft')\r\n\r\n// State tracking\r\nif ( ! root['sectorCount'] || $prop('CurrentSectorIndex') > root['sectorCount'] ) root['sectorCount'] = $prop('CurrentSectorIndex')\r\nif ( root['sectorCount'] > 1 && $prop('CurrentSectorIndex') == 1 ) root['finalSectorIndex'] = root['sectorCount']\r\n\r\n// Always default in pit\r\nif ( $prop('IsInPit') ) return '--:--.---'\r\n\r\n// Setup\r\nlet sectorOffset = -2 // Update me\r\nlet sectorIndex = $prop('CurrentSectorIndex') + sectorOffset\r\nif ( root['finalSectorIndex'] && sectorIndex < 1 ) sectorIndex = root['finalSectorIndex'] + sectorIndex\r\nif ( sectorIndex < 1 ) return '--:--.---'\r\nlet nextSectorIndex = sectorIndex + 1 \r\nif ( root['finalSectorIndex'] && nextSectorIndex > root['finalSectorIndex'] ) nextSectorIndex = 1\r\n\r\n// Normal case when not final sector\r\nlet sectorTimeKey = 'Sector' + sectorIndex + 'Time'\r\nif ( $prop(sectorTimeKey) ) return $prop(sectorTimeKey)\r\n\r\n// Handle final sector\r\nif ( ! root['finalSectorIndex'] ) return '--:--.---'\r\nif ( sectorIndex == root['finalSectorIndex'] ) {\r\n\tlet sectorTimeKey = 'Sector' + sectorIndex + 'LastLapTime'\r\n\tif ( $prop(sectorTimeKey) ) return $prop(sectorTimeKey)\r\n\treturn '--:--.---'\r\n}\r\n\r\nreturn '--:--.---'"},"Mode":2,"TargetPropertyName":"Text"},"TextColor":{"Formula":{"Interpreter":1,"Expression":"// Session reset logic: Session restarted, SimHub replay rewind, etc.\r\nif ( root['SessionTimeLeft'] && timespantoseconds($prop('SessionTimeLeft')) > timespantoseconds(root['SessionTimeLeft']) ) {\r\n\tfor ( var key in root ) delete root[key]\r\n}\r\nroot['SessionTimeLeft'] = $prop('SessionTimeLeft')\r\n\r\n// State tracking\r\nif ( ! root['sectorCount'] || $prop('CurrentSectorIndex') > root['sectorCount'] ) root['sectorCount'] = $prop('CurrentSectorIndex')\r\nif ( root['sectorCount'] > 1 && $prop('CurrentSectorIndex') == 1 ) root['finalSectorIndex'] = root['sectorCount']\r\n\r\n// Always gray in pit\r\nif ( $prop('IsInPit') ) return 'Gray'\r\n\r\n// Return now until we have final sector count\r\nif ( ! root['finalSectorIndex'] ) return 'Gray'\r\n\r\n// Setup\r\nlet sectorOffset = -2 // Update me\r\nlet sectorIndex = $prop('CurrentSectorIndex') + sectorOffset\r\nif ( sectorIndex < 1 ) sectorIndex = root['finalSectorIndex'] + sectorIndex\r\nif ( sectorIndex < 1 ) return 'Gray'\r\nlet lastLapSector = ( sectorIndex >= $prop('CurrentSectorIndex') ) ? true : false\r\nlet nextSectorIndex = sectorIndex + 1 \r\nif ( nextSectorIndex > root['finalSectorIndex'] ) nextSectorIndex = 1\r\nlet prevSectorIndex = sectorIndex - 1\r\nif ( sectorIndex < 1 ) prevSectorIndex = root['finalSectorIndex']\r\nlet sectorLap = $prop('CurrentLap')\r\nif ( lastLapSector ) sectorLap--\r\n\r\n// Generate keys\r\nlet sectorBestTimeKey = 'Sector' + sectorIndex + 'BestTime'\r\nlet sectorTimeKey = 'Sector' + sectorIndex + 'Time'\r\nif ( sectorIndex == root['finalSectorIndex'] ) {\r\n\tsectorTimeKey = 'Sector' + sectorIndex + 'LastLapTime'\r\n}\r\n\r\n// Return if data not ready yet\r\nif ( ! $prop(sectorTimeKey) ) return 'Gray'\r\n\r\nreturn 'Orange' // No deltas shown on first row"},"Mode":2,"TargetPropertyName":"TextColor"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":30.0,"Text":"-","TextColor":"#FFFFA500","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":310.0,"Top":80.0,"Visible":true,"Width":150.0,"Name":"Sector2DeltaValue","RenderingSkip":60,"Bindings":{"Text":{"Formula":{"Interpreter":1,"Expression":"// Session reset logic: Session restarted, SimHub replay rewind, etc.\r\nif ( root['SessionTimeLeft'] && timespantoseconds($prop('SessionTimeLeft')) > timespantoseconds(root['SessionTimeLeft']) ) {\r\n\tfor ( var key in root ) delete root[key]\r\n}\r\nroot['SessionTimeLeft'] = $prop('SessionTimeLeft')\r\n\r\n// State tracking\r\nif ( ! root['sectorCount'] || $prop('CurrentSectorIndex') > root['sectorCount'] ) root['sectorCount'] = $prop('CurrentSectorIndex')\r\nif ( root['sectorCount'] > 1 && $prop('CurrentSectorIndex') == 1 ) root['finalSectorIndex'] = root['sectorCount']\r\n\r\n// Return now until we have final sector count\r\nif ( ! root['finalSectorIndex'] ) return '-'\r\n\r\n// Setup\r\nlet sectorOffset = -2 // Update me\r\nlet sectorIndex = $prop('CurrentSectorIndex') + sectorOffset\r\nif ( sectorIndex < 1 ) sectorIndex = root['finalSectorIndex'] + sectorIndex\r\nif ( sectorIndex < 1 ) return '-'\r\nlet lastLapSector = ( sectorIndex >= $prop('CurrentSectorIndex') ) ? true : false\r\nlet nextSectorIndex = sectorIndex + 1 \r\nif ( nextSectorIndex > root['finalSectorIndex'] ) nextSectorIndex = 1\r\nlet prevSectorIndex = sectorIndex - 1\r\nif ( sectorIndex < 1 ) prevSectorIndex = root['finalSectorIndex']\r\nlet sectorLap = $prop('CurrentLap')\r\nif ( lastLapSector ) sectorLap--\r\n\r\n// Generate keys\r\nlet sectorBestTimeKey = 'Sector' + sectorIndex + 'BestTime'\r\nlet sectorTimeKey = 'Sector' + sectorIndex + 'Time'\r\nif ( sectorIndex == root['finalSectorIndex'] ) {\r\n\tsectorTimeKey = 'Sector' + sectorIndex + 'LastLapTime'\r\n}\r\nlet oldSectorDeltaStrKey = 'oldSector' + sectorIndex + 'Lap' + sectorLap + 'DeltaStr'\r\n\r\n// Return if data not ready yet\r\nif ( ! $prop(sectorTimeKey) ) return '-'\r\n\r\n// Record Sector*BestTimes while in their sector because Sector*BestTime gets overwritten as soon as you finish the sector with a new best time so there's no way to compare\r\nlet currentSectorBestTimeKey = 'Sector' + $prop('CurrentSectorIndex') + 'BestTime'\r\nlet currentSectorBestTime = $prop(currentSectorBestTimeKey)\r\nif ( ! root[currentSectorBestTimeKey] ) root[currentSectorBestTimeKey] = $prop(currentSectorBestTimeKey)\r\n\r\n// Always generate previous sector's delta if not done yet\r\nlet targetSectorIndex = $prop('CurrentSectorIndex') - 1\r\nlet targetSectorLap = $prop('CurrentLap')\r\nif ( targetSectorIndex < 1 ) {\r\n\ttargetSectorIndex = root['finalSectorIndex']\r\n\ttargetSectorLap--\r\n}\r\nlet targetSectorBestTimeKey = 'Sector' + targetSectorIndex + 'BestTime'\r\nlet targetSectorTimeKey = 'Sector' + targetSectorIndex + 'Time'\r\nif ( targetSectorIndex == root['finalSectorIndex'] ) {\r\n\ttargetSectorTimeKey = 'Sector' + targetSectorIndex + 'LastLapTime'\r\n}\r\nlet targetOldSectorDeltaStrKey = 'oldSector' + targetSectorIndex + 'Lap' + targetSectorLap + 'DeltaStr'\r\nif ( ! $prop(targetSectorTimeKey) ) return '-' // Wait for valid data to generate delta\r\nif ( ! root[targetOldSectorDeltaStrKey] ) {\r\n\t// Compare new time to old best time\r\n\t// - Newest sector time\r\n\tlet s = $prop(targetSectorTimeKey)\r\n\tlet sSec = timespantoseconds(s)\r\n\t// - Best sector time\r\n\t//let sb = $prop(targetSectorBestTimeKey)\r\n\tlet sb = root[targetSectorBestTimeKey]\r\n\tlet sbSec = timespantoseconds(sb)\r\n\t// - Generate delta\r\n\tif ( sSec && sbSec ) {\r\n\t\tlet delta = sSec - sbSec\r\n\t\tlet deltats = secondstotimespan(delta)\r\n\t\tlet deltaStr = '-' // Handle no delta which shouldn't show +/-\r\n\t\tif ( delta ) deltaStr = toshorttime(deltats, 3, true) // ie. +/- 0.000\r\n\t\troot[targetOldSectorDeltaStrKey] = deltaStr\r\n\t}\r\n}\r\n\r\n// Always refresh sector best times after deltas are generated\r\nroot[currentSectorBestTimeKey] = $prop(currentSectorBestTimeKey)\r\n\r\n// Return old value if already generated\r\nif ( root[oldSectorDeltaStrKey] ) return root[oldSectorDeltaStrKey]\r\n\r\nreturn '-'"},"Mode":2,"TargetPropertyName":"Text"},"TextColor":{"Formula":{"Interpreter":1,"Expression":"// Session reset logic: Session restarted, SimHub replay rewind, etc.\r\nif ( root['SessionTimeLeft'] && timespantoseconds($prop('SessionTimeLeft')) > timespantoseconds(root['SessionTimeLeft']) ) {\r\n\tfor ( var key in root ) delete root[key]\r\n}\r\nroot['SessionTimeLeft'] = $prop('SessionTimeLeft')\r\n\r\n// State tracking\r\nif ( ! root['sectorCount'] || $prop('CurrentSectorIndex') > root['sectorCount'] ) root['sectorCount'] = $prop('CurrentSectorIndex')\r\nif ( root['sectorCount'] > 1 && $prop('CurrentSectorIndex') == 1 ) root['finalSectorIndex'] = root['sectorCount']\r\n\r\n// Return now until we have final sector count\r\nif ( ! root['finalSectorIndex'] ) return 'Gray'\r\n\r\n// Setup\r\nlet sectorOffset = -2 // Update me\r\nlet sectorIndex = $prop('CurrentSectorIndex') + sectorOffset\r\nif ( sectorIndex < 1 ) sectorIndex = root['finalSectorIndex'] + sectorIndex\r\nif ( sectorIndex < 1 ) return 'Gray'\r\nlet lastLapSector = ( sectorIndex >= $prop('CurrentSectorIndex') ) ? true : false\r\nlet nextSectorIndex = sectorIndex + 1 \r\nif ( nextSectorIndex > root['finalSectorIndex'] ) nextSectorIndex = 1\r\nlet prevSectorIndex = sectorIndex - 1\r\nif ( sectorIndex < 1 ) prevSectorIndex = root['finalSectorIndex']\r\nlet sectorLap = $prop('CurrentLap')\r\nif ( lastLapSector ) sectorLap--\r\n\r\n// Generate keys\r\nlet sectorBestTimeKey = 'Sector' + sectorIndex + 'BestTime'\r\nlet sectorTimeKey = 'Sector' + sectorIndex + 'Time'\r\nif ( sectorIndex == root['finalSectorIndex'] ) {\r\n\tsectorTimeKey = 'Sector' + sectorIndex + 'LastLapTime'\r\n}\r\nlet oldSectorDeltaColorKey = 'oldSector' + sectorIndex + 'Lap' + sectorLap + 'DeltaColor'\r\n\r\n// Return if data not ready yet\r\nif ( ! $prop(sectorTimeKey) ) return 'Gray'\r\n\r\n// Store Sector*BestTime while in its sector because Sector*BestTime gets overwritten as soon as you finish the sector with a new best time so this allows us to compare\r\n// - Best times are updated with the new best time below after deltas are generated\r\nlet currentSectorBestTimeKey = 'Sector' + $prop('CurrentSectorIndex') + 'BestTime'\r\nlet currentSectorBestTime = $prop(currentSectorBestTimeKey)\r\nif ( ! root[currentSectorBestTimeKey] ) root[currentSectorBestTimeKey] = $prop(currentSectorBestTimeKey)\r\n\r\n// Always generate previous sector's delta if not done yet\r\nlet targetSectorIndex = $prop('CurrentSectorIndex') - 1\r\nlet targetSectorLap = $prop('CurrentLap')\r\nif ( targetSectorIndex < 1 ) {\r\n\ttargetSectorIndex = root['finalSectorIndex']\r\n\ttargetSectorLap--\r\n}\r\nlet targetSectorBestTimeKey = 'Sector' + targetSectorIndex + 'BestTime'\r\nlet targetSectorTimeKey = 'Sector' + targetSectorIndex + 'Time'\r\nif ( targetSectorIndex == root['finalSectorIndex'] ) {\r\n\ttargetSectorTimeKey = 'Sector' + targetSectorIndex + 'LastLapTime'\r\n}\r\nlet targetOldSectorDeltaColorKey = 'oldSector' + targetSectorIndex + 'Lap' + targetSectorLap + 'DeltaColor'\r\n\r\n// Wait for valid data to generate delta\r\nif ( ! $prop(targetSectorTimeKey) ) return 'Gray'\r\n\r\n// Generate deltas\r\nif ( ! root[targetOldSectorDeltaColorKey] ) {\r\n\t// Compare new time to old best time\r\n\t// - Newest sector time\r\n\tlet s = $prop(targetSectorTimeKey)\r\n\tlet sSec = timespantoseconds(s)\r\n\t// - Best sector time\r\n\t//let sb = $prop(targetSectorBestTimeKey)\r\n\tlet sb = root[targetSectorBestTimeKey]\r\n\tlet sbSec = timespantoseconds(sb)\r\n\t// - Generate delta\r\n\tif ( sSec && sbSec ) {\r\n\t\tlet delta = sSec - sbSec\r\n\t\tlet deltats = secondstotimespan(delta)\r\n\t\tdeltaColor = 'Orange'\r\n\t\tif ( delta ) {\r\n\t\t if ( delta < 0 ) deltaColor = 'LimeGreen'\r\n\t\t if ( delta > 0 ) deltaColor = 'Red'\r\n\t\t}\r\n\t\troot[targetOldSectorDeltaColorKey] = deltaColor\r\n\t}\r\n}\r\n\r\n// Always refresh sector best times after deltas are generated\r\nroot[currentSectorBestTimeKey] = $prop(currentSectorBestTimeKey)\r\n\r\n// Return old value if already generated\r\nif ( root[oldSectorDeltaColorKey] ) return root[oldSectorDeltaColorKey]\r\n\r\nreturn 'Orange'"},"Mode":2,"TargetPropertyName":"TextColor"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":30.0,"Text":"-3","TextColor":"#FFFFFFFF","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":10.0,"Top":120.0,"Visible":true,"Width":145.0,"Name":"Sector3TimeText","RenderingSkip":60,"Bindings":{"TextColor":{"Formula":{"Interpreter":1,"Expression":"// Session reset logic: Session restarted, SimHub replay rewind, etc.\r\nif ( root['SessionTimeLeft'] && timespantoseconds($prop('SessionTimeLeft')) > timespantoseconds(root['SessionTimeLeft']) ) {\r\n\tfor ( var key in root ) delete root[key]\r\n}\r\nroot['SessionTimeLeft'] = $prop('SessionTimeLeft')\r\n\r\n// State tracking\r\nif ( ! root['sectorCount'] || $prop('CurrentSectorIndex') > root['sectorCount'] ) root['sectorCount'] = $prop('CurrentSectorIndex')\r\nif ( root['sectorCount'] > 1 && $prop('CurrentSectorIndex') == 1 ) root['finalSectorIndex'] = root['sectorCount']\r\n\r\n// Always gray in pit\r\nif ( $prop('IsInPit') ) return 'Gray'\r\n\r\n// Setup\r\nlet sectorOffset = -3 // Update me\r\nlet sectorIndex = $prop('CurrentSectorIndex') + sectorOffset\r\nif ( root['finalSectorIndex'] && sectorIndex < 1 ) sectorIndex = root['finalSectorIndex'] + sectorIndex\r\nif ( sectorIndex < 1 ) return 'Gray'\r\nlet lastLapSector = ( sectorIndex >= $prop('CurrentSectorIndex') ) ? true : false\r\nlet nextSectorIndex = sectorIndex + 1 \r\nif ( root['finalSectorIndex'] && nextSectorIndex > root['finalSectorIndex'] ) nextSectorIndex = 1\r\n\r\n// Always gray for last lap sectors\r\nif ( lastLapSector ) return 'Gray'\r\n\r\nreturn 'Orange'"},"Mode":2,"TargetPropertyName":"TextColor"},"Text":{"Formula":{"Interpreter":1,"Expression":"// Session reset logic: Session restarted, SimHub replay rewind, etc.\r\nif ( root['SessionTimeLeft'] && timespantoseconds($prop('SessionTimeLeft')) > timespantoseconds(root['SessionTimeLeft']) ) {\r\n\tfor ( var key in root ) delete root[key]\r\n}\r\nroot['SessionTimeLeft'] = $prop('SessionTimeLeft')\r\n\r\n// State tracking\r\nif ( ! root['sectorCount'] || $prop('CurrentSectorIndex') > root['sectorCount'] ) root['sectorCount'] = $prop('CurrentSectorIndex')\r\nif ( root['sectorCount'] > 1 && $prop('CurrentSectorIndex') == 1 ) root['finalSectorIndex'] = root['sectorCount']\r\n\r\n// Setup\r\nlet sectorOffset = -3 // Update me\r\nlet sectorIndex = $prop('CurrentSectorIndex') + sectorOffset\r\nif ( root['finalSectorIndex'] && sectorIndex < 1 ) sectorIndex = root['finalSectorIndex'] + sectorIndex\r\nif ( sectorIndex < 1 ) return ''\r\nlet lastLapSector = ( sectorIndex >= $prop('CurrentSectorIndex') ) ? true : false\r\nlet nextSectorIndex = sectorIndex + 1 \r\nif ( root['finalSectorIndex'] && nextSectorIndex > root['finalSectorIndex'] ) nextSectorIndex = 1\r\n\r\nreturn sectorIndex"},"Mode":2,"TargetPropertyName":"Text"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":30.0,"Text":"--:--.---","TextColor":"#FFFFA500","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":155.0,"Top":120.0,"Visible":true,"Width":150.0,"Name":"Sector3TimeValue","RenderingSkip":60,"Bindings":{"Text":{"FormatString":"m\\:ss\\.fff","Formula":{"Interpreter":1,"Expression":"// Session reset logic: Session restarted, SimHub replay rewind, etc.\r\nif ( root['SessionTimeLeft'] && timespantoseconds($prop('SessionTimeLeft')) > timespantoseconds(root['SessionTimeLeft']) ) {\r\n\tfor ( var key in root ) delete root[key]\r\n}\r\nroot['SessionTimeLeft'] = $prop('SessionTimeLeft')\r\n\r\n// State tracking\r\nif ( ! root['sectorCount'] || $prop('CurrentSectorIndex') > root['sectorCount'] ) root['sectorCount'] = $prop('CurrentSectorIndex')\r\nif ( root['sectorCount'] > 1 && $prop('CurrentSectorIndex') == 1 ) root['finalSectorIndex'] = root['sectorCount']\r\n\r\n// Always default in pit\r\nif ( $prop('IsInPit') ) return '--:--.---'\r\n\r\n// Setup\r\nlet sectorOffset = -3 // Update me\r\nlet sectorIndex = $prop('CurrentSectorIndex') + sectorOffset\r\nif ( root['finalSectorIndex'] && sectorIndex < 1 ) sectorIndex = root['finalSectorIndex'] + sectorIndex\r\nif ( sectorIndex < 1 ) return '--:--.---'\r\nlet nextSectorIndex = sectorIndex + 1 \r\nif ( root['finalSectorIndex'] && nextSectorIndex > root['finalSectorIndex'] ) nextSectorIndex = 1\r\n\r\n// Generate keys\r\nlet oldSectorTimeKey = 'oldSector' + sectorIndex + 'Lap' + $prop('CurrentLap')\r\nlet prevOldSectorTimeKey = 'oldSector' + sectorIndex + 'Lap' + ($prop('CurrentLap') - 1)\r\n\r\n/*// Clean up previous sector time Refresh sector time if needed: New lap forces a new fetch\r\nif ( ! root[oldSectorTimeKey] && root[prevOldSectorTimeKey] ) delete root[prevOldSectorTimeKey]*/\r\n\r\n/*// Return old value if already generated\r\nif ( root[oldSectorTimeKey] ) return root[oldSectorTimeKey]*/\r\n\r\n// Normal case when not final sector\r\nlet sectorTimeKey = 'Sector' + sectorIndex + 'Time'\r\nif ( $prop(sectorTimeKey) ) {\r\n\t//root[oldSectorTimeKey] = $prop(sectorTimeKey)\r\n\treturn $prop(sectorTimeKey)\r\n}\r\n\r\n// Handle final sector\r\nif ( ! root['finalSectorIndex'] ) return '--:--.---'\r\nif ( sectorIndex == root['finalSectorIndex'] ) {\r\n\tlet sectorTimeKey = 'Sector' + sectorIndex + 'LastLapTime'\r\n\tif ( $prop(sectorTimeKey) ) {\r\n\t\t//root[oldSectorTimeKey] = $prop(sectorTimeKey)\r\n\t\treturn $prop(sectorTimeKey)\r\n\t}\r\n\treturn '--:--.---'\r\n}\r\n\r\nreturn '--:--.---'"},"Mode":2,"TargetPropertyName":"Text"},"TextColor":{"Formula":{"Interpreter":1,"Expression":"// Session reset logic: Session restarted, SimHub replay rewind, etc.\r\nif ( root['SessionTimeLeft'] && timespantoseconds($prop('SessionTimeLeft')) > timespantoseconds(root['SessionTimeLeft']) ) {\r\n\tfor ( var key in root ) delete root[key]\r\n}\r\nroot['SessionTimeLeft'] = $prop('SessionTimeLeft')\r\n\r\n// State tracking\r\nif ( ! root['sectorCount'] || $prop('CurrentSectorIndex') > root['sectorCount'] ) root['sectorCount'] = $prop('CurrentSectorIndex')\r\nif ( root['sectorCount'] > 1 && $prop('CurrentSectorIndex') == 1 ) root['finalSectorIndex'] = root['sectorCount']\r\n\r\n// Always gray in pit\r\nif ( $prop('IsInPit') ) return 'Gray'\r\n\r\n// Return now until we have final sector count\r\nif ( ! root['finalSectorIndex'] ) return 'Gray'\r\n\r\n// Setup\r\nlet sectorOffset = -3 // Update me\r\nlet sectorIndex = $prop('CurrentSectorIndex') + sectorOffset\r\nif ( sectorIndex < 1 ) sectorIndex = root['finalSectorIndex'] + sectorIndex\r\nif ( sectorIndex < 1 ) return 'Gray'\r\nlet lastLapSector = ( sectorIndex >= $prop('CurrentSectorIndex') ) ? true : false\r\nlet nextSectorIndex = sectorIndex + 1 \r\nif ( nextSectorIndex > root['finalSectorIndex'] ) nextSectorIndex = 1\r\nlet prevSectorIndex = sectorIndex - 1\r\nif ( sectorIndex < 1 ) prevSectorIndex = root['finalSectorIndex']\r\nlet sectorLap = $prop('CurrentLap')\r\nif ( lastLapSector ) sectorLap--\r\n\r\n// Generate keys\r\nlet sectorBestTimeKey = 'Sector' + sectorIndex + 'BestTime'\r\nlet sectorTimeKey = 'Sector' + sectorIndex + 'Time'\r\nif ( sectorIndex == root['finalSectorIndex'] ) {\r\n\tsectorTimeKey = 'Sector' + sectorIndex + 'LastLapTime'\r\n}\r\n\r\n// Return if data not ready yet\r\nif ( ! $prop(sectorTimeKey) ) return 'Gray'\r\n\r\nreturn 'Orange' // No deltas shown on first row"},"Mode":2,"TargetPropertyName":"TextColor"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":30.0,"Text":"-","TextColor":"#FFFFA500","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":310.0,"Top":120.0,"Visible":true,"Width":150.0,"Name":"Sector3DeltaValue","RenderingSkip":60,"Bindings":{"Text":{"Formula":{"Interpreter":1,"Expression":"// Session reset logic: Session restarted, SimHub replay rewind, etc.\r\nif ( root['SessionTimeLeft'] && timespantoseconds($prop('SessionTimeLeft')) > timespantoseconds(root['SessionTimeLeft']) ) {\r\n\tfor ( var key in root ) delete root[key]\r\n}\r\nroot['SessionTimeLeft'] = $prop('SessionTimeLeft')\r\n\r\n// State tracking\r\nif ( ! root['sectorCount'] || $prop('CurrentSectorIndex') > root['sectorCount'] ) root['sectorCount'] = $prop('CurrentSectorIndex')\r\nif ( root['sectorCount'] > 1 && $prop('CurrentSectorIndex') == 1 ) root['finalSectorIndex'] = root['sectorCount']\r\n\r\n// Return now until we have final sector count\r\nif ( ! root['finalSectorIndex'] ) return '-'\r\n\r\n// Setup\r\nlet sectorOffset = -3 // Update me\r\nlet sectorIndex = $prop('CurrentSectorIndex') + sectorOffset\r\nif ( sectorIndex < 1 ) sectorIndex = root['finalSectorIndex'] + sectorIndex\r\nif ( sectorIndex < 1 ) return '-'\r\nlet lastLapSector = ( sectorIndex >= $prop('CurrentSectorIndex') ) ? true : false\r\nlet nextSectorIndex = sectorIndex + 1 \r\nif ( nextSectorIndex > root['finalSectorIndex'] ) nextSectorIndex = 1\r\nlet prevSectorIndex = sectorIndex - 1\r\nif ( sectorIndex < 1 ) prevSectorIndex = root['finalSectorIndex']\r\nlet sectorLap = $prop('CurrentLap')\r\nif ( lastLapSector ) sectorLap--\r\n\r\n// Generate keys\r\nlet sectorBestTimeKey = 'Sector' + sectorIndex + 'BestTime'\r\nlet sectorTimeKey = 'Sector' + sectorIndex + 'Time'\r\nif ( sectorIndex == root['finalSectorIndex'] ) {\r\n\tsectorTimeKey = 'Sector' + sectorIndex + 'LastLapTime'\r\n}\r\nlet oldSectorDeltaStrKey = 'oldSector' + sectorIndex + 'Lap' + sectorLap + 'DeltaStr'\r\n\r\n// Return if data not ready yet\r\nif ( ! $prop(sectorTimeKey) ) return '-'\r\n\r\n// Record Sector*BestTimes while in their sector because Sector*BestTime gets overwritten as soon as you finish the sector with a new best time so there's no way to compare\r\nlet currentSectorBestTimeKey = 'Sector' + $prop('CurrentSectorIndex') + 'BestTime'\r\nlet currentSectorBestTime = $prop(currentSectorBestTimeKey)\r\nif ( ! root[currentSectorBestTimeKey] ) root[currentSectorBestTimeKey] = $prop(currentSectorBestTimeKey)\r\n\r\n// Always generate previous sector's delta if not done yet\r\nlet targetSectorIndex = $prop('CurrentSectorIndex') - 1\r\nlet targetSectorLap = $prop('CurrentLap')\r\nif ( targetSectorIndex < 1 ) {\r\n\ttargetSectorIndex = root['finalSectorIndex']\r\n\ttargetSectorLap--\r\n}\r\nlet targetSectorBestTimeKey = 'Sector' + targetSectorIndex + 'BestTime'\r\nlet targetSectorTimeKey = 'Sector' + targetSectorIndex + 'Time'\r\nif ( targetSectorIndex == root['finalSectorIndex'] ) {\r\n\ttargetSectorTimeKey = 'Sector' + targetSectorIndex + 'LastLapTime'\r\n}\r\nlet targetOldSectorDeltaStrKey = 'oldSector' + targetSectorIndex + 'Lap' + targetSectorLap + 'DeltaStr'\r\nif ( ! $prop(targetSectorTimeKey) ) return '-' // Wait for valid data to generate delta\r\nif ( ! root[targetOldSectorDeltaStrKey] ) {\r\n\t// Compare new time to old best time\r\n\t// - Newest sector time\r\n\tlet s = $prop(targetSectorTimeKey)\r\n\tlet sSec = timespantoseconds(s)\r\n\t// - Best sector time\r\n\t//let sb = $prop(targetSectorBestTimeKey)\r\n\tlet sb = root[targetSectorBestTimeKey]\r\n\tlet sbSec = timespantoseconds(sb)\r\n\t// - Generate delta\r\n\tif ( sSec && sbSec ) {\r\n\t\tlet delta = sSec - sbSec\r\n\t\tlet deltats = secondstotimespan(delta)\r\n\t\tlet deltaStr = '-' // Handle no delta which shouldn't show +/-\r\n\t\tif ( delta ) deltaStr = toshorttime(deltats, 3, true) // ie. +/- 0.000\r\n\t\troot[targetOldSectorDeltaStrKey] = deltaStr\r\n\t}\r\n}\r\n\r\n// Always refresh sector best times after deltas are generated\r\nroot[currentSectorBestTimeKey] = $prop(currentSectorBestTimeKey)\r\n\r\n// Return old value if already generated\r\nif ( root[oldSectorDeltaStrKey] ) return root[oldSectorDeltaStrKey]\r\n\r\nreturn '-'"},"Mode":2,"TargetPropertyName":"Text"},"TextColor":{"Formula":{"Interpreter":1,"Expression":"// Session reset logic: Session restarted, SimHub replay rewind, etc.\r\nif ( root['SessionTimeLeft'] && timespantoseconds($prop('SessionTimeLeft')) > timespantoseconds(root['SessionTimeLeft']) ) {\r\n\tfor ( var key in root ) delete root[key]\r\n}\r\nroot['SessionTimeLeft'] = $prop('SessionTimeLeft')\r\n\r\n// State tracking\r\nif ( ! root['sectorCount'] || $prop('CurrentSectorIndex') > root['sectorCount'] ) root['sectorCount'] = $prop('CurrentSectorIndex')\r\nif ( root['sectorCount'] > 1 && $prop('CurrentSectorIndex') == 1 ) root['finalSectorIndex'] = root['sectorCount']\r\n\r\n// Return now until we have final sector count\r\nif ( ! root['finalSectorIndex'] ) return 'Gray'\r\n\r\n// Setup\r\nlet sectorOffset = -3 // Update me\r\nlet sectorIndex = $prop('CurrentSectorIndex') + sectorOffset\r\nif ( sectorIndex < 1 ) sectorIndex = root['finalSectorIndex'] + sectorIndex\r\nif ( sectorIndex < 1 ) return 'Gray'\r\nlet lastLapSector = ( sectorIndex >= $prop('CurrentSectorIndex') ) ? true : false\r\nlet nextSectorIndex = sectorIndex + 1 \r\nif ( nextSectorIndex > root['finalSectorIndex'] ) nextSectorIndex = 1\r\nlet prevSectorIndex = sectorIndex - 1\r\nif ( sectorIndex < 1 ) prevSectorIndex = root['finalSectorIndex']\r\nlet sectorLap = $prop('CurrentLap')\r\nif ( lastLapSector ) sectorLap--\r\n\r\n// Generate keys\r\nlet sectorBestTimeKey = 'Sector' + sectorIndex + 'BestTime'\r\nlet sectorTimeKey = 'Sector' + sectorIndex + 'Time'\r\nif ( sectorIndex == root['finalSectorIndex'] ) {\r\n\tsectorTimeKey = 'Sector' + sectorIndex + 'LastLapTime'\r\n}\r\nlet oldSectorDeltaColorKey = 'oldSector' + sectorIndex + 'Lap' + sectorLap + 'DeltaColor'\r\n\r\n// Return if data not ready yet\r\nif ( ! $prop(sectorTimeKey) ) return 'Gray'\r\n\r\n// Store Sector*BestTime while in its sector because Sector*BestTime gets overwritten as soon as you finish the sector with a new best time so this allows us to compare\r\n// - Best times are updated with the new best time below after deltas are generated\r\nlet currentSectorBestTimeKey = 'Sector' + $prop('CurrentSectorIndex') + 'BestTime'\r\nlet currentSectorBestTime = $prop(currentSectorBestTimeKey)\r\nif ( ! root[currentSectorBestTimeKey] ) root[currentSectorBestTimeKey] = $prop(currentSectorBestTimeKey)\r\n\r\n// Always generate previous sector's delta if not done yet\r\nlet targetSectorIndex = $prop('CurrentSectorIndex') - 1\r\nlet targetSectorLap = $prop('CurrentLap')\r\nif ( targetSectorIndex < 1 ) {\r\n\ttargetSectorIndex = root['finalSectorIndex']\r\n\ttargetSectorLap--\r\n}\r\nlet targetSectorBestTimeKey = 'Sector' + targetSectorIndex + 'BestTime'\r\nlet targetSectorTimeKey = 'Sector' + targetSectorIndex + 'Time'\r\nif ( targetSectorIndex == root['finalSectorIndex'] ) {\r\n\ttargetSectorTimeKey = 'Sector' + targetSectorIndex + 'LastLapTime'\r\n}\r\nlet targetOldSectorDeltaColorKey = 'oldSector' + targetSectorIndex + 'Lap' + targetSectorLap + 'DeltaColor'\r\n\r\n// Wait for valid data to generate delta\r\nif ( ! $prop(targetSectorTimeKey) ) return 'Gray'\r\n\r\n// Generate deltas\r\nif ( ! root[targetOldSectorDeltaColorKey] ) {\r\n\t// Compare new time to old best time\r\n\t// - Newest sector time\r\n\tlet s = $prop(targetSectorTimeKey)\r\n\tlet sSec = timespantoseconds(s)\r\n\t// - Best sector time\r\n\t//let sb = $prop(targetSectorBestTimeKey)\r\n\tlet sb = root[targetSectorBestTimeKey]\r\n\tlet sbSec = timespantoseconds(sb)\r\n\t// - Generate delta\r\n\tif ( sSec && sbSec ) {\r\n\t\tlet delta = sSec - sbSec\r\n\t\tlet deltats = secondstotimespan(delta)\r\n\t\tdeltaColor = 'Orange'\r\n\t\tif ( delta ) {\r\n\t\t if ( delta < 0 ) deltaColor = 'LimeGreen'\r\n\t\t if ( delta > 0 ) deltaColor = 'Red'\r\n\t\t}\r\n\t\troot[targetOldSectorDeltaColorKey] = deltaColor\r\n\t}\r\n}\r\n\r\n// Always refresh sector best times after deltas are generated\r\nroot[currentSectorBestTimeKey] = $prop(currentSectorBestTimeKey)\r\n\r\n// Return old value if already generated\r\nif ( root[oldSectorDeltaColorKey] ) return root[oldSectorDeltaColorKey]\r\n\r\nreturn 'Orange'"},"Mode":2,"TargetPropertyName":"TextColor"}}}]}],"SnapToGrid":true,"HideLabels":true,"ShowForeground":true,"ForegroundOpacity":100.0,"ShowBackground":true,"BackgroundOpacity":100.0,"ShowBoundingRectangles":true,"GridSize":10,"Images":[],"Metadata":{"Title":"SHO XD Style RSplits SimHub Overlay","Author":"Shovas","ScreenCount":1.0,"InGameScreensIndexs":[0],"IdleScreensIndexs":[],"MainPreviewIndex":0,"IsOverlay":true,"Width":470.0,"Height":164.0,"OverlaySizeWarning":false,"MetadataVersion":2.0,"EnableOnDashboardMessaging":true,"PitScreensIndexs":[]},"ShowOnScreenControls":true,"IsOverlay":true,"EnableClickThroughOverlay":true,"EnableOnDashboardMessaging":true}