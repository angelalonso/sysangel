{"DashboardDebugManager":{"LastPlacement":"156,156,590,164","Maximized":false},"Version":2,"Id":"47cd6ef4-4500-4d59-96f3-83a7cd58751d","BaseHeight":164,"BaseWidth":590,"BackgroundColor":"#FF000000","Screens":[{"Name":"Screen1","InGameScreen":true,"IdleScreen":false,"PitScreen":false,"ScreenId":"90ac7a58-f9d3-4331-8086-eda0607b144c","AllowOverlays":true,"IsForegroundLayer":false,"IsOverlayLayer":false,"OverlayTriggerExpression":{"Expression":""},"OverlayMaxDuration":0,"OverlayMinDuration":0,"IsBackgroundLayer":false,"BackgroundColor":"#00FFFFFF","Items":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins","IsRectangleItem":true,"BackgroundColor":"#FF000000","BorderStyle":{"RadiusTopLeft":6,"RadiusTopRight":6,"RadiusBottomLeft":6,"RadiusBottomRight":6},"Height":164.0,"Left":0.0,"Opacity":50.0,"Top":0.0,"Visible":true,"Width":590.0,"Name":"BGRect","RenderingSkip":10},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"ShadowDepth":2,"ShadowColor":"#FF000000","Font":"Segoe UI","FontWeight":"Bold","FontSize":30.0,"Text":"LAP / REMAINING","TextColor":"#FFFFFFFF","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":0.0,"Top":0.0,"Visible":true,"Width":270.0,"Name":"LapRemainingLabel"},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.BuiltIn.LapText, SimHub.Plugins","Format":"0","NoDataText":"1","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":30.0,"TextColor":"#FFFFA500","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":374.0,"Top":0.0,"Visible":true,"Width":40.0,"Name":"LapValue","RenderingSkip":60},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":30.0,"Text":"/","TextColor":"#FFFFA500","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":409.0,"Top":0.0,"Visible":true,"Width":40.0,"Name":"LapDivider"},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":30.0,"Text":"0:00.00","TextColor":"#FFFFA500","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":435.0,"Top":0.0,"Visible":true,"Width":140.0,"Name":"TimeRemainingValue","RenderingSkip":60,"Bindings":{"Text":{"FormatString":"h\\:mm\\:ss","Formula":{"Interpreter":1,"Expression":"return $prop('SessionTimeLeft')"},"Mode":2,"TargetPropertyName":"Text"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"ShadowDepth":2,"ShadowColor":"#FF000000","Font":"Segoe UI","FontWeight":"Bold","FontSize":30.0,"Text":"BEST LAP","TextColor":"#FFFFFFFF","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":0.0,"Top":41.0,"Visible":true,"Width":270.0,"Name":"BestLapLabel"},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":30.0,"Text":"0:00.000","TextColor":"#FFFFA500","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":435.0,"Top":41.0,"Visible":true,"Width":140.0,"Name":"BestLapValue","RenderingSkip":60,"Bindings":{"Text":{"FormatString":"m\\:ss\\.fff","Formula":{"Interpreter":1,"Expression":"return $prop('BestLapTime')"},"Mode":2,"TargetPropertyName":"Text"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"ShadowDepth":2,"ShadowColor":"#FF000000","Font":"Segoe UI","FontWeight":"Bold","FontSize":30.0,"Text":"CURRENT LAP","TextColor":"#FFFFFFFF","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":0.0,"Top":82.0,"Visible":true,"Width":270.0,"Name":"CurrentLapLabel"},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":30.0,"Text":"0:00.000","TextColor":"#FFFFA500","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":435.0,"Top":82.0,"Visible":true,"Width":140.0,"Name":"CurrentLapValue","Bindings":{"Text":{"FormatString":"m\\:ss\\.fff","Formula":{"Interpreter":1,"Expression":"defaultReturn = '0:00.000'\r\nif ( $prop('IsInPit') ) return defaultReturn\r\nisValidLap = $prop('DataCorePlugin.Computed.Fuel_CurrentLapIsValidForTracking')\r\nif ( ! isValidLap ) return defaultReturn\r\nreturn $prop('CurrentLapTime')"},"Mode":2,"TargetPropertyName":"Text"}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"ShadowDepth":2,"ShadowColor":"#FF000000","Font":"Segoe UI","FontWeight":"Bold","FontSize":30.0,"Text":"SPLIT GAP","TextColor":"#FFFFFFFF","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":0.0,"Top":122.0,"Visible":true,"Width":270.0,"Name":"LastSectorTimeLabel"},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":30.0,"Text":"0:00.000","TextColor":"#FFFFA500","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":435.0,"Top":121.0,"Visible":true,"Width":140.0,"Name":"LastSectorTimeValue","RenderingSkip":60,"Bindings":{"Text":{"FormatString":"","Formula":{"Interpreter":1,"Expression":"// Check support\r\nsplitSupported = ( $prop('SelfsplitDelta') )\r\nif ( ! splitSupported ) return '-'\r\n\r\nlet delta = $prop('SelfsplitDelta')\r\nlet adelta = Math.abs(delta)\r\nlet min = Math.floor(adelta / 60)\r\nlet sec = Math.abs(adelta % 60)\r\n\r\nif ( ! delta ) return '0:00.000'\r\nlet str = min + ':' + format(sec, '00.000')\r\nif ( delta > 0 ) return '+' + str\r\nreturn '-' + str\r\n\r\n// Old style:\r\n\r\ndefaultReturn = '-'\r\ncurrentLap = $prop('CurrentLap')\r\nlastLap = currentLap - 1\r\n\r\n// Exit early if we can\r\nif ( $prop('IsInPit') ) return defaultReturn\r\nif ( ! $prop('Sector1Time') ) return defaultReturn\r\n\r\n// Last Sector Logic (Assumes only 3 sectors on a track...)\r\nsector = $prop('CurrentSectorIndex')\r\nlastSector = sector - 1\r\nif ( lastSector < 1 ) lastSector = 3\r\n//return sector\r\n//return lastSector\r\n//maxSectors = 0\r\n//for ( i=1; i <= 10; i++ ) {\r\n\t//if ( $prop('Sector' + i + 'BestTime') ) maxSectors++\r\n//}\r\n\r\nsector1BestTime = $prop('Sector1BestTime')\r\nsector2BestTime = $prop('Sector2BestTime')\r\nsector3BestTime = $prop('Sector3BestTime')\r\n//return sector1BestTime\r\n//return sector2BestTime\r\n//return sector3BestTime\r\n\r\n// Store previous Sector3BestTime because Sector3BestTime gets overridden as soon as you finish Sector 3 (if you set a best time) so there's no way to compare\r\nif ( ! root['prevSector3BestTime'] ) root['prevSector3BestTime'] = $prop('Sector3BestTime')\r\n//return root['prevSector3BestTime']\r\nif ( lastSector == 2 ) root['prevSector3BestTime'] = $prop('Sector3BestTime')\r\n//return root['prevSector3BestTime']\r\n//if ( ! root['realLastSectorTime'] ) root['realLastSectorTime'] = $prop('LastSectorTime')\r\n//if ( lastSector == 2 ) root['prevSector3BestTime'] = $prop('Sector3BestTime')\r\n\r\n// Skip until Lap 3 when we finally have comparison times\r\nif ( currentLap < 3 ) {\r\n\treturn defaultReturn\r\n}\r\n\r\n// Only report on valid laps\r\nisValidLap = $prop('DataCorePlugin.Computed.Fuel_CurrentLapIsValidForTracking')\r\nif ( ! isValidLap ) return defaultReturn\r\n\r\n// Report lap delta after sector 3 since sector 3 times aren't available in sector 1\r\nif ( sector == 1 ) {\r\n  delta = $prop('PersistantTrackerPlugin.SessionBestLastLapDelta')\r\n  //return delta\r\n  if ( currentLap < 4 ) return defaultReturn // No lap delta until lap 3 sets a time to compare to lap 2\r\n  if ( delta > 0 ) return '+' + Math.abs(delta).toFixed(3)\r\n  if ( delta < 0 ) return '-' + Math.abs(delta).toFixed(3)\r\n  return '0.000'\r\n}\r\n\r\nsectorBestTime = $prop('Sector' + lastSector + 'BestLapTime')\r\nif ( lastSector == 3 ) sectorBestTime = root['prevSector3BestTime']\r\nif ( ! sectorBestTime ) return defaultReturn // Sector 3 no data until Lap 3 (Lap 1 not available, Lap 2 sets time, Lap 3 sets comparison)\r\n//return sectorBestTime\r\nsectorBestTimeParts = sectorBestTime.toString().split(':')\r\nsectorBestTimeHour = parseInt(sectorBestTimeParts[0])\r\nsectorBestTimeMin = parseInt(sectorBestTimeParts[1])\r\nsectorBestTimeSec = parseFloat(sectorBestTimeParts[2])\r\n//return sectorBestTimeHour\r\n//return sectorBestTimeMin\r\n//return sectorBestTimeSec\r\n//sectorBestTimeSecParts = sectorBestTimeParts[2].split('.')\r\n//sectorBestTimeSec = parseFloat(sectorBestTimeSecParts[0])\r\n//sectorBestTimeSecFrac = sectorBestTimeSecParts[1]\r\nsectorBestTimeTotalSec = (sectorBestTimeHour * 60 * 60) + (sectorBestTimeMin * 60) + sectorBestTimeSec\r\n//return sectorBestTimeTotalSec\r\n//return sectorBestTimeParts[2]\r\n\r\nif ( lastSector == 3 && currentLap < 4 ) return defaultReturn\r\n\r\n//sectorLastTime = $prop('LastSectorTime')\r\nsectorLastTime = $prop('Sector' + lastSector + 'Time')\r\n//return sectorLastTime\r\n//if ( ! sectorLastTime ) sectorLastTime = $prop('Sector' + lastSector + 'LastLapTime')\r\n//return sectorLastTime\r\n//if ( lastSector == 3 && sectorLastTime == sectorBestTime ) return defaultReturn\r\n//return sectorLastTime\r\nsectorLastTimeParts = sectorLastTime.toString().split(':')\r\nsectorLastTimeHour = parseInt(sectorLastTimeParts[0])\r\nsectorLastTimeMin = parseInt(sectorLastTimeParts[1])\r\nsectorLastTimeSec = parseFloat(sectorLastTimeParts[2])\r\n//return sectorLastTimeHour\r\n//return sectorLasTimeMin\r\n//return sectorBestTimeSec\r\n//sectorLastTimeSecParts = sectorLastTimeParts[2].split('.')\r\n//sectorLastTimeSec = parseFloat(sectorLastTimeSecParts[0])\r\n//sectorLAstTimeSecFrac = sectorLastTimeSecParts[1]\r\nsectorLastTimeTotalSec = (sectorLastTimeHour * 60 * 60) + (sectorLastTimeMin * 60) + sectorLastTimeSec\r\n//return sectorLastTimeTotalSec\r\n\r\nsectorDelta = sectorLastTimeTotalSec - sectorBestTimeTotalSec\r\nif ( sectorDelta > 0 ) return '+' + Math.abs(sectorDelta).toFixed(3)\r\nif ( sectorDelta < 0 ) return '-' + Math.abs(sectorDelta).toFixed(3)\r\nreturn '0.000'"},"Mode":2,"TargetPropertyName":"Text"},"TextColor":{"Formula":{"Interpreter":1,"Expression":"// Check support\r\nsplitSupported = ( $prop('SelfsplitDelta') )\r\nif ( ! splitSupported ) return 'Gray'\r\n\r\n// Exit early if we can\r\nif ( $prop('IsInPit') ) return 'Orange'\r\nif ( ! $prop('Sector1Time') ) return 'Orange'\r\nisValidLap = $prop('DataCorePlugin.Computed.Fuel_CurrentLapIsValidForTracking')\r\nif ( ! isValidLap ) return 'Orange'\r\n\r\n\r\n  //delta = $prop('PersistantTrackerPlugin.SessionBestLastLapDelta')\r\n  delta = $prop('SelfsplitDelta')\r\n  if ( ! delta ) return 'Orange'\r\n  if ( delta < 0 ) return 'LimeGreen'\r\n  return 'Red'\r\n"},"Mode":2,"TargetPropertyName":"TextColor"}}}]}],"SnapToGrid":false,"HideLabels":true,"ShowForeground":true,"ForegroundOpacity":100.0,"ShowBackground":true,"BackgroundOpacity":100.0,"ShowBoundingRectangles":false,"GridSize":10,"Images":[],"Metadata":{"Title":"SHO XD Style Lap SimHub Overlay","Author":"Shovas","ScreenCount":1.0,"InGameScreensIndexs":[0],"IdleScreensIndexs":[],"MainPreviewIndex":0,"IsOverlay":true,"Width":590.0,"Height":164.0,"OverlaySizeWarning":false,"MetadataVersion":2.0,"EnableOnDashboardMessaging":true,"PitScreensIndexs":[]},"ShowOnScreenControls":true,"IsOverlay":true,"EnableClickThroughOverlay":true,"EnableOnDashboardMessaging":true}