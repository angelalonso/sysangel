                  "Mode": 2,
                  "TargetPropertyName": "Maximum"
                },
                "GaugeColor": {
                  "$id": "26",
                  "Formula": {
                    "$id": "27",
                    "Interpreter": 1,
                    "Expression": "//if ( $prop('Rpms') >= $prop('CarSettings_RedLineRPM') ) return 'Red';\r\n//$prop('CarSettings_CurrentGearRedLineRPM')\r\nif ( $prop('Rpms') * 1.0234375 >= $prop('CarSettings_MaxRPM') ) return 'Red';\r\nif ( $prop('Rpms') > $prop('CarSettings_CurrentGearRedLineRPM') ) return 'Gold';\r\n//if ( $prop('CarSettings_RPMShiftLight2') ) return 'DarkGreen'\r\n//if ( $prop('CarSettings_RPMShiftLight1') ) return 'ForestGreen'\r\nreturn 'LimeGreen';"
                  },
                  "Mode": 2,
                  "TargetPropertyName": "GaugeColor"
                },
                "BlinkEnabled": {
                  "$id": "28",
                  "Formula": {
                    "$id": "29",
                    "Interpreter": 1,
                    "Expression": "// Bug: PitLimiterOn is just enabled/disabled when in pits not when you engage/disengage the pit limiter\r\n//if ( $prop('PitLimiterOn') ) return true;\r\nreturn false;"
                  },
                  "Mode": 2,
                  "TargetPropertyName": "BlinkEnabled"
                }
