                  "Formula": {
                    "$id": "23",
                    "Interpreter": 1,
                    "Expression": "//return $prop('MaxSpeedKmh')\r\n//$prop('CarSettings_MaxRPM')\r\n//$prop('CarSettings_RedLineRPM')\r\nreturn $prop('Rpms')"
                  },
                  "Mode": 2,
