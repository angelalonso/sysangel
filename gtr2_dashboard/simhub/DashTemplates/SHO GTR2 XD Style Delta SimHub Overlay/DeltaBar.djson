                    "$id": "37",
                    "Interpreter": 1,
                    "Expression": "//[PersistantTrackerPlugin.SessionBestLiveDeltaSeconds] != 0 &&\r\n//[DataCorePlugin.GameRawData.CurrentPlayer.mInGarageStall] = 0\r\n//return $prop('PersistantTrackerPlugin.SessionBestLiveDeltaSeconds')\r\n//return $prop('DeltaToSessionBest')\r\nif ( $prop('IsInPit') ) return false;\r\nif ( $prop('PersistantTrackerPlugin.SessionBestLiveDeltaSeconds') === null ) return false;\r\nreturn true;"
                  },
                  "Mode": 2,
                  "TargetPropertyName": "Visible"
                }
              }
