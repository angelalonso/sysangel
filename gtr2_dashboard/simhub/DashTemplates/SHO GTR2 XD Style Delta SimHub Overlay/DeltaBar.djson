                  "Formula": {
                    "$id": "27",
                    "Interpreter": 1,
                    "Expression": "//[PersistantTrackerPlugin.SessionBestLiveDeltaSeconds] != 0 &&\r\n//[DataCorePlugin.GameRawData.CurrentPlayer.mInGarageStall] = 0\r\n//return $prop('PersistantTrackerPlugin.SessionBestLiveDeltaSeconds') == 0 && $prop('DataCorePlugin.GameRawData.CurrentPlayer.mInGarageStall') == 0\r\n//return $prop('PersistantTrackerPlugin.SessionBestLiveDeltaSeconds') == 0\r\n// Bad attribute: && $prop('DataCorePlugin.GameRawData.CurrentPlayer.mInGarageStall') == 0\r\n//return true\r\n//return $prop('PersistantTrackerPlugin.SessionBestLiveDeltaSeconds')\r\nif ( $prop('IsInPit') ) return false;\r\n//Bad: if ( $prop('DeltaToSessionBest') === null ) return true;\r\nif ( $prop('PersistantTrackerPlugin.SessionBestLiveDeltaSeconds') === null ) return true;\r\nreturn false;"
                  },
                  "Mode": 2,
                  "TargetPropertyName": "Visible"
                }
              }
            },
            {
              "$id": "28",
              "$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins",
              "IsTextItem": true,
              "ShadowDepth": 1,
              "ShadowBlur": 2,
              "ShadowDirection": 315,
              "ShadowColor": "#FF000000",
