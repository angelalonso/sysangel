                  "$id": "20",
                  "Formula": {
                    "$id": "21",
                    "Interpreter": 1,
                    "Expression": "if ( $prop('IsInPit') ) return false;\r\nif ( $prop('PersistantTrackerPlugin.SessionBestLiveDeltaSeconds') === null ) return true;\r\nreturn false;\r\n//return $prop('DeltaToSessionBest')\r\n//return deltaSec != null && deltaSec != 0 && $prop('IsInPit') != 0\r\n//deltaSec = $prop('PersistantTrackerPlugin.SessionBestLiveDeltaSeconds')\r\n//return deltaSec != null && deltaSec != 0 && $prop('IsInPit') != 0\r\n// Bad attribute: && $prop('DataCorePlugin.GameRawData.CurrentPlayer.mInGarageStall') == 0"
                  },
                  "Mode": 2,
                  "TargetPropertyName": "Visible"
                }
              }
            },
