              "Id": "ce10d703-35de-4938-ace9-46cc69dd7e0f",
              "IsFreezed": false,
              "IsSelected": false,
              "Name": "Delta",
              "RenderingSkip": 0,
              "Sid": 1,
              "Bindings": {
                "$id": "31",
                "Text": {
                  "$id": "32",
                  "FormatString": "0.00",
                  "Formula": {
                    "$id": "33",
                    "Interpreter": 1,
                    "Expression": "//(isnull([PersistantTrackerPlugin.SessionBestLiveDeltaSeconds],0) >=0?'+ ':'')\r\n//+format(isnull([PersistantTrackerPlugin.SessionBestLiveDeltaSeconds],0) ,'0.00')\r\n//[PersistantTrackerPlugin.AllTimeBestLiveDeltaProgressSeconds]\r\n//delta = $prop('PersistantTrackerPlugin.AllTimeBestLiveDeltaProgressSeconds')\r\n//delta = $prop('PersistantTrackerPlugin.SessionBestLiveDeltaProgressSeconds')\r\n//delta = $prop('PersistantTrackerPlugin.SessionBestLiveDeltaSeconds')\r\n\r\ndefaultReturn = '+ 0.00'\r\n\r\n// Only report on valid laps\r\nisValidLap = $prop('DataCorePlugin.Computed.Fuel_CurrentLapIsValidForTracking')\r\nif ( ! isValidLap ) return defaultReturn\r\n\r\ndelta = $prop('PersistantTrackerPlugin.SessionBestLiveDeltaSeconds')\r\nif ( delta  ) {\r\n  if ( delta > 0 ) return '+ ' + Math.abs(delta).toFixed(2)\r\n  if ( delta < 0 ) return '- ' + Math.abs(delta).toFixed(2)\r\n  return defaultReturn\r\n}\r\nreturn defaultReturn"
                  },
                  "Mode": 2,
                  "TargetPropertyName": "Text"
                },
                "TextColor": {
                  "$id": "34",
                  "Formula": {
                    "$id": "35",
                    "Interpreter": 1,
                    "Expression": "defaultReturn = '0.00'\r\n\r\n// Only report on valid laps\r\nisValidLap = $prop('DataCorePlugin.Computed.Fuel_CurrentLapIsValidForTracking')\r\nif ( ! isValidLap ) return defaultReturn\r\n\r\nreturn $prop('PersistantTrackerPlugin.SessionBestLiveDeltaSeconds')"
                  },
                  "StartColor": "#FF23D623",
                  "EnableMiddleColor": true,
                  "MiddleColor": "#FFFFFFFF",
                  "MiddleColorValue": 0.0,
                  "EndColor": "#FFFF0000",
                  "StartColorValue": -0.1,
                  "EndColorValue": 1.0,
                  "Mode": 4,
                  "TargetPropertyName": "TextColor"
                },
                "Visible": {
                  "$id": "36",
