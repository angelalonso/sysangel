use std::fs::File;
use std::io::{self, Read, Write};
use std::process::Command;

struct MouseTracker {
    x: i32,
    y: i32,
    width: i32,
    height: i32,
}

impl MouseTracker {
    fn new() -> Self {
        let (width, height) = Self::get_screen_size();
        let (x, y) = Self::get_initial_position(width, height);
        
        println!("Screen: {}x{}", width, height);
        println!("Tracking mouse position... (Press Ctrl+C to exit)\n");
        
        MouseTracker { x, y, width, height }
    }
    
    fn get_screen_size() -> (i32, i32) {
        // Try xrandr
        if let Ok(output) = Command::new("xrandr").output() {
            if let Ok(stdout) = String::from_utf8(output.stdout) {
                for line in stdout.lines() {
                    if line.contains('*') && line.contains('+') {
                        for word in line.split_whitespace() {
                            if word.contains('x') {
                                let parts: Vec<&str> = word.split('x').collect();
                                if parts.len() == 2 {
                                    if let (Ok(w), Ok(h)) = (parts[0].parse(), parts[1].parse()) {
                                        return (w, h);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        (1920, 1080) // Default
    }
    
    fn get_initial_position(width: i32, height: i32) -> (i32, i32) {
        if let Ok(output) = Command::new("xdotool").arg("getmouselocation").output() {
            if let Ok(stdout) = String::from_utf8(output.stdout) {
                let mut x = width / 2;
                let mut y = height / 2;
                
                for part in stdout.split_whitespace() {
                    if part.starts_with("x:") {
                        x = part[2..].parse().unwrap_or(x);
                    } else if part.starts_with("y:") {
                        y = part[2..].parse().unwrap_or(y);
                    }
                }
                return (x, y);
            }
        }
        (width / 2, height / 2)
    }
    
    fn update(&mut self, dx: i32, dy: i32) {
        // Move and clamp to screen bounds
        self.x = (self.x + dx).max(0).min(self.width - 1);
        self.y = (self.y + dy).max(0).min(self.height - 1);
        
        // Display
        print!("\rX: {:4}/{:4} ({:5.1}%)  Y: {:4}/{:4} ({:5.1}%)",
            self.x, self.width - 1, (self.x as f32 / (self.width - 1) as f32) * 100.0,
            self.y, self.height - 1, (self.y as f32 / (self.height - 1) as f32) * 100.0);
        
        io::stdout().flush().unwrap();
    }
    
    fn run(&mut self, device_path: &str) -> io::Result<()> {
        let mut file = File::open(device_path)?;
        let mut buffer = [0u8; 3];
        
        // Initial display
        print!("\rX: {:4}/{:4}  Y: {:4}/{:4}", 
            self.x, self.width - 1, self.y, self.height - 1);
        io::stdout().flush().unwrap();
        
        loop {
            match file.read_exact(&mut buffer) {
                Ok(_) => {
                    // Decode mouse movement (standard PS/2 protocol)
                    let dx = buffer[1] as i8 as i32;
                    let dy = buffer[2] as i8 as i32;
                    
                    self.update(dx, dy);
                }
                Err(e) if e.kind() == io::ErrorKind::UnexpectedEof => {
                    continue;
                }
                Err(e) => {
                    eprintln!("\nError: {}", e);
                    break;
                }
            }
        }
        
        println!();
        Ok(())
    }
}

fn main() -> io::Result<()> {
    let device_path = std::env::args()
        .nth(1)
        .unwrap_or_else(|| "/dev/input/mouse2".to_string());
    
    let mut tracker = MouseTracker::new();
    tracker.run(&device_path)
}
