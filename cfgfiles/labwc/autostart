# Notification daemon
mako &

# Bar
waybar &

# Wallpaper
swaybg -c '#323232' &

# PolicyKit (Required for root/sudo prompts in apps)
/usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 &

# Idle/Locking
swayidle -w \
    timeout 300 'swaylock -f -c 000000' \
    timeout 600 'wlopm --off *' \
    resume 'wlopm --on *' \
    before-sleep 'swaylock -f -c 000000' &
