<?xml version="1.0"?>
<labwc_config>
  <desktops number="4" />
  <keyboard>
    <default />
    <keybind key="W-S-q"><action name="Close" /></keybind>
    <!-- Desktop Switching -->
    <keybind key="W-h"><action name="GoToDesktop" to="left" wrap="no"/></keybind>
    <keybind key="W-l"><action name="GoToDesktop" to="right" wrap="no"/></keybind>
    <keybind key="W-1"><action name="GoToDesktop" to="1"/></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2"/></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3"/></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4"/></keybind>
    <keybind key="W-S-h"><action name="SendToDesktop" to="left" wrap="no"/></keybind>
    <keybind key="W-S-l"><action name="SendToDesktop" to="right" wrap="no"/></keybind>
    <keybind key="W-S-1"><action name="SendToDesktop" to="1"/></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop" to="2"/></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop" to="3"/></keybind>
    <keybind key="W-S-4"><action name="SendToDesktop" to="4"/></keybind>
    <!-- Window Switching -->
    <keybind key="A-Tab"><action name="NextWindow" /></keybind>
    <keybind key="A-S-Tab"><action name="PreviousWindow" /></keybind>
    <!-- App Shortcuts -->
    <keybind key="W-t"><action name="Execute" command="terminator"/></keybind>
    <keybind key="W-k"><action name="Execute" command="keepassxc"/></keybind>
    <keybind key="W-a"><action name="Execute" command="firefox"/></keybind>
    <keybind key="W-w"><action name="Execute" command="/home/aaf/Software/helium-0.12.4.1-x86_64.AppImage --enable-features=UseOzonePlatform --ozone-platform=wayland"/></keybind>
    <keybind key="W-f"><action name="Execute" command="nautilus"/></keybind>
    <keybind key="W-c"><action name="Execute" command="/usr/bin/google-chrome-stable --enable-features=UseOzonePlatform --ozone-platform=wayland --enable-wayland-ime"/></keybind>
    
    <!-- System -->
    <keybind key="W-S-e"><action name="Exit"/></keybind>
    <keybind key="W-S-r"><action name="Reconfigure"/></keybind>
    <!-- Lock Screen -->
    <keybind key="Mod1-C-q"><action name="Execute" command="swaylock -c 1c3335"/></keybind>
    <keybind key="W-S-s"><action name="Execute" command="pavucontrol"/></keybind>
    <keybind key="Super_R"><action name="Execute" command="wofi --show drun"/></keybind>
    <!-- Run Menu (F2) -->
    <keybind key="F2"><action name="Execute" command="wofi --show run"/></keybind>
    <keybind key="W-S-y"><action name="Execute" command="killall wofi"/></keybind>
    
    <!-- Audio & Brightness -->
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="pamixer -i 5"/></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="pamixer -d 5"/></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="pamixer -t"/></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="sudo brightnessctl set 5%+" /></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="sudo brightnessctl set 5%-" /></keybind>

    <!-- Screenshotting -->
    <keybind key="XF86Eject">
      <action name="Execute" command="env XDG_CURRENT_DESKTOP=sway flameshot gui"/>
    </keybind>
  </keyboard>
  <layer-rule>
    <layer-shell name="waybar" exclusive="true" />
  </layer-rule>
</labwc_config>
